---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import FAQAccordion from "../components/ui/FAQAccordion.astro";
import CTASection from "../components/ui/CTASection.astro";
import Icon from "../components/icons/Icon.astro";
import { pageMetadata } from "../data/metadata";
import { faqCategories, allFaqs } from "../data/faqs";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<MainLayout title={pageMetadata.faq.title} description={pageMetadata.faq.description} schema={faqSchema}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow">FAQ</span>
        <h1>Questions local business owners ask before getting started.</h1>
        <p>Everything you need to know about pricing, plans, hosting, Google Business Profile help, SEO, and Google Ads management in one place.</p>
        <ul class="hero__bullets">
          <li><span class="icon-circle"><Icon name="dollar" /></span>No setup fees</li>
          <li><span class="icon-circle"><Icon name="cloud" /></span>Hosting included</li>
          <li><span class="icon-circle"><Icon name="shield" /></span>No fake guarantees</li>
        </ul>
      </div>
      <div class="hero__media">
        <img src="/images/hometown-boost/contact-growth-graphic.svg" alt="Contact form and growth chart for website plan questions." width="720" height="420" />
      </div>
    </div>
  </section>

  {faqCategories.map((category) => (
    <Section title={category.title}>
      <FAQAccordion items={category.items} />
    </Section>
  ))}

  <CTASection
    title="Still have questions?"
    description="Tell us about your business and we can help point you toward the right starting point."
    primaryCta={{ label: "Ask a Question", href: "/contact/", variant: "secondary" }}
    secondaryCta={{ label: "View Plans", href: "/pricing/" }}
  />
</MainLayout>
