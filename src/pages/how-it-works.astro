---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import CTASection from '../components/ui/CTASection.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import {pageMetadata} from '../data/metadata';
import {selectFaqs} from '../data/faqs';
const steps=[
 ['Start with the right plan.','Tell us about your services, service area, current website, and what you want to improve. We’ll recommend a plan and explain the price, scope, and minimum term before you commit.'],
 ['Share the details. We’ll build the site.','Send your business information, logo, photos if available, and domain details. We turn them into a clear, professional website that works on phones and larger screens.'],
 ['Review it before it goes live.','Check your services, business details, and design, then share your feedback. We complete the agreed edits and prepare your website to launch with your approval.'],
 ['Keep your website working for you.','Your plan covers hosting, SSL, maintenance, and updates at your plan’s level. When you need extra pages or services, we’ll explain the scope and cost before adding them.']
];
---
<MainLayout {...pageMetadata.howItWorks}>
  <PageHero eyebrow="A CLEAR PATH TO LAUNCH." title="Your new website. Without taking on another job." description="You know your business. We handle the website build and ongoing care, with clear steps and your approval before launch."><div class="actions"><Button href="/contact/">Find my plan <span aria-hidden="true">↗</span></Button></div></PageHero>
  <Section>{steps.map(([title,copy],i)=><article class="editorial-row"><span class="editorial-row__number">0{i+1} /</span><h3>{title}</h3><p>{copy}</p></article>)}</Section>
  <Section variant="light"><div class="split"><div><span class="eyebrow">WHAT WE NEED FROM YOU.</span><h2 style="margin:20px 0">Bring the basics.<br />We’ll bring it together.</h2><p>You don’t need everything ready to get in touch. These details help us build a site that accurately represents your business.</p><ul class="check-list">{['Business name, contact details, and hours','Services and the towns or areas you cover','Your logo and photos, if you have them','Existing website and domain access, if available','A short introduction to your business'].map(item=><li>{item}</li>)}</ul></div><div class="card"><h3>How long will it take?</h3><p>Timing depends on your page count, content, and review rounds. We’ll outline the expected scope and timeline before work begins.</p><p>Ready business details, photos, and timely feedback help us keep your launch on track.</p><h3 style="margin-top:30px">And after launch?</h3><p>Lite includes a quarterly small update. Starter includes a monthly small edit. Growth includes monthly edits, and Leader includes priority monthly updates.</p></div></div></Section>
  <Section title="A few details before you start." align="center"><FAQAccordion items={selectFaqs(['What do you need from me to start?','Do you write the content?','Why are there minimum terms?','How do updates work?'])}/></Section>
  <CTASection title="Start with a plan for your business." description="Tell us what you do and what your website needs. We’ll recommend a plan and explain what’s included."/>
</MainLayout>
