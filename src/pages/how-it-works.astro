---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import CTASection from '../components/ui/CTASection.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import {pageMetadata} from '../data/metadata';
import {selectFaqs} from '../data/faqs';
const steps=[
 ['Tell us about your business.','Share your services, service area, current website, and what you want to improve. We’ll recommend a plan and explain the scope before you commit.'],
 ['Send the basics. We’ll do the building.','Once your plan is agreed, send your business details, logo, photos if available, and domain information. We handle the structure, design, mobile layout, and setup.'],
 ['Take a look. Give the go-ahead.','You review the website, check the details, and share your feedback. We work through the agreed edits and prepare the site for launch.'],
 ['Get back to business. We’ve got the site.','Your plan covers hosting, SSL, maintenance, and ongoing updates at your plan’s level. Add more pages or support as your needs change.']
];
---
<MainLayout {...pageMetadata.howItWorks}>
  <PageHero eyebrow="LESS TECH TO LEARN. MORE TIME FOR YOUR BUSINESS." title="From “we need a website” to “we’re open online.”" description="A clear process, a little input from you, and the website work handled. Here’s how we get there."><div class="actions"><Button href="/contact/">Let’s get started <span aria-hidden="true">↗</span></Button></div></PageHero>
  <Section>{steps.map(([title,copy],i)=><article class="editorial-row"><span class="editorial-row__number">0{i+1} /</span><h3>{title}</h3><p>{copy}</p></article>)}</Section>
  <Section variant="light"><div class="split"><div><span class="eyebrow">A LITTLE PREP GOES A LONG WAY.</span><h2 style="margin:20px 0">Bring the basics.<br />We’ll bring it together.</h2><p>You don’t need everything ready to start a conversation. These are the details that help the build move forward.</p><ul class="check-list">{['Business name, contact details, and hours','Services and the towns or areas you cover','Your logo and photos, if you have them','Existing website and domain access, if available','A short introduction to your business'].map(item=><li>{item}</li>)}</ul></div><div class="card"><h3>How long will it take?</h3><p>Timing depends on your page count, content, and review rounds. We’ll outline the expected scope and timeline before work begins.</p><p>Having your details, photos, and feedback ready helps your site move toward launch.</p><h3 style="margin-top:30px">And after launch?</h3><p>Lite includes a quarterly small update. Starter includes a monthly small edit. Growth includes monthly edits, and Leader includes priority updates.</p></div></div></Section>
  <Section title="Before we get going." align="center"><FAQAccordion items={selectFaqs(['What do you need from me to start?','Do you write the content?','Why are there minimum terms?','How do updates work?'])}/></Section>
  <CTASection title="Let’s make the first step easy." description="Tell us where your business is today. We’ll help you figure out what comes next."/>
</MainLayout>
