---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import PricingCard from '../components/ui/PricingCard.astro';
import PricingComparisonTable from '../components/ui/PricingComparisonTable.astro';
import PlanSelector from '../components/infographics/PlanSelector.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import CTASection from '../components/ui/CTASection.astro';
import {pricingPlans,googleAdsPricing} from '../data/pricingPlans';
import {addOns,addOnScopeNote} from '../data/addOns';
import {selectFaqs} from '../data/faqs';
import {pageMetadata} from '../data/metadata';
const faqs=selectFaqs(['Why are there minimum terms?','What happens after the minimum term?','What happens if I cancel?','Can I upgrade later?','Do I own the website?','Is Google Ads included?']);
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))};
---
<MainLayout {...pageMetadata.pricing} schema={schema}>
  <PageHero eyebrow="YOUR NEXT CHAPTER, PRICED CLEARLY." title="Big plans for your business. A simple plan for your website." description="No setup fees. No guessing what’s included. Choose the support that fits today, with room to grow tomorrow." center />
  <Section class="section--compact"><div class="grid grid--4 pricing-grid">{pricingPlans.map(plan=><PricingCard plan={plan} showNotIncluded/>)}</div>
    <p class="pricing-footnote">Your website build and support are spread across the minimum term. After that, plans continue month to month unless canceled with 30 days’ written notice. <a href="/terms/">Read the terms ↗</a></p>
  </Section>
  <Section variant="light" eyebrow="START WHERE YOU ARE." title="There’s a right-sized next step." align="center"><PlanSelector/></Section>
  <Section id="compare" eyebrow="THE DETAILS, ALL IN ONE PLACE." title="Compare your options." description="Every plan includes hosting, SSL, maintenance, mobile-friendly design, and a clear way for customers to get in touch."><span id="plan-comparison"></span><PricingComparisonTable/></Section>
  <Section variant="light" eyebrow="A LITTLE EXTRA, WHEN YOU NEED IT." title="Add to your plan." description={addOnScopeNote}>
    <div class="grid grid--3">{addOns.map(addOn=><article class="card"><h3>{addOn.name}</h3><p>{addOn.price}</p></article>)}</div>
  </Section>
  <Section><div class="split"><div><span class="eyebrow">READY FOR MORE SEARCH TRAFFIC?</span><h2 style="margin-top:20px">Put Google Ads to work.</h2><p style="margin-top:22px">Optional Google Search Ads management, with a separate budget paid directly to Google.</p></div><div class="card"><h3>{googleAdsPricing.formulaLabel}</h3><p>{googleAdsPricing.note} Website plan fees are separate.</p><Button href="/google-ads/" variant="primary">See how ads work <span aria-hidden="true">↗</span></Button></div></div></Section>
  <Section variant="light" title="Before you choose." align="center"><FAQAccordion items={faqs}/></Section>
  <CTASection title="A little guidance goes a long way." description="Tell us about your business. We’ll recommend a starting point that fits your needs." primaryCta={{label:'Help me find my plan',href:'/contact/'}}/>
</MainLayout>
