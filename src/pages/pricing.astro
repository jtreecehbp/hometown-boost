---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import PricingCard from "../components/ui/PricingCard.astro";
import PricingComparisonTable from "../components/ui/PricingComparisonTable.astro";
import AdsPricingTable from "../components/ui/AdsPricingTable.astro";
import FAQAccordion from "../components/ui/FAQAccordion.astro";
import CTASection from "../components/ui/CTASection.astro";
import Icon from "../components/icons/Icon.astro";
import PlanSelector from "../components/infographics/PlanSelector.astro";
import PricingInfographic from "../components/infographics/PricingInfographic.astro";
import AdsPricingFormula from "../components/infographics/AdsPricingFormula.astro";
import MonthlyValueFlywheel from "../components/infographics/MonthlyValueFlywheel.astro";
import ComparisonInfographic from "../components/infographics/ComparisonInfographic.astro";
import { pageMetadata } from "../data/metadata";
import { pricingPlans } from "../data/pricingPlans";
import { addOns, addOnScopeNote } from "../data/addOns";
import { selectFaqs } from "../data/faqs";

const pricingFaqs = selectFaqs([
  "Are there setup fees?",
  "Why are there minimum terms?",
  "Can I upgrade later?",
  "Is hosting included?",
  "What happens after the minimum term?",
  "Are results guaranteed?",
  "Is Google Ads included?",
  "Who pays the Google Ads budget?",
  "What if I need more pages?",
  "Can you help with my Google Business Profile?",
]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pricingFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<MainLayout title={pageMetadata.pricing.title} description={pageMetadata.pricing.description} schema={faqSchema}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <h1>Simple monthly website plans. No setup fees.</h1>
        <p>Choose the level of support that fits your business today, then grow when you are ready.</p>
        <div class="hero__actions">
          <Button href="/contact/" variant="secondary" size="lg">Ask for a Recommendation</Button>
          <Button href="#plan-comparison" variant="outline" size="lg">Compare Features</Button>
        </div>
        <ul class="hero__bullets">
          <li><span class="icon-circle"><Icon name="dollar" /></span>No setup fees</li>
          <li><span class="icon-circle"><Icon name="cloud" /></span>Hosting included</li>
          <li><span class="icon-circle"><Icon name="wrench" /></span>Maintenance included</li>
          <li><span class="icon-circle"><Icon name="chart" /></span>Upgrade anytime</li>
        </ul>
      </div>
      <div class="hero__media">
        <img src="/images/hometown-boost/hero-hometown-business-growth.svg" alt="Local business website screens and storefronts." width="900" height="600" />
      </div>
    </div>
  </section>

  <PricingInfographic />

  <Section title="Choose your starting point." align="center">
    <div class="grid grid--4 pricing-grid">
      {pricingPlans.map((plan) => <PricingCard plan={plan} showNotIncluded />)}
    </div>
    <div class="commitment-summary" aria-label="Minimum commitment totals">
      {pricingPlans.map((plan) => (
        <article>
          <strong>{plan.shortName}</strong>
          <span>{plan.priceLabel} x {plan.minimumMonths} months</span>
          <b>{plan.minimumCommitment}</b>
        </article>
      ))}
    </div>
    <p class="note commitment-note">
      Why minimum terms? Hometown Boost does not charge setup fees. The website build, hosting, maintenance, and support are spread across the minimum service term so local businesses can start without a large upfront website bill.
    </p>
    <div class="actions" style="justify-content: center;">
      <Button href="/contact/" variant="secondary" size="lg">Ask Which Plan Fits</Button>
    </div>
  </Section>

  <Section variant="cream" title="Which plan fits your business?" align="center">
    <PlanSelector />
  </Section>

  <Section id="plan-comparison" title="Compare every feature." description="Growth is highlighted because it is the main recommended plan for service businesses that want stronger local visibility." align="center" class="plan-comparison-section">
    <PricingComparisonTable />
  </Section>

  <Section variant="light" title="What you get every month." description="Your monthly plan covers more than a one-time website file. It keeps the essentials handled." align="center">
    <MonthlyValueFlywheel />
  </Section>

  <Section title="Need something extra? Add it when you need it." description={addOnScopeNote}>
    <div class="grid grid--3">
      {addOns.map((addOn) => (
        <article class="card">
          <h3>{addOn.name}</h3>
          <p style="margin-top: 0.5rem;"><strong>{addOn.price}</strong></p>
        </article>
      ))}
    </div>
  </Section>

  <Section variant="cream" title="Add Google Ads management when you are ready for more traffic." description="Google Ads is optional. Ad spend is separate and paid directly to Google.">
    <div class="grid grid--2">
      <AdsPricingFormula />
      <AdsPricingTable />
    </div>
    <div class="actions">
      <Button href="/contact/?service=google-ads" variant="secondary">Ask About Google Ads</Button>
    </div>
  </Section>

  <Section title="A clear alternative to DIY or a large agency." align="center">
    <ComparisonInfographic />
  </Section>

  <Section variant="light" title="Pricing FAQs" align="center">
    <FAQAccordion items={pricingFaqs} />
  </Section>

  <CTASection
    title="Not sure which plan fits?"
    description="Tell us about your business and we will help point you toward the right starting point."
    primaryCta={{ label: "Check My Fit", href: "/contact/", variant: "secondary" }}
    secondaryCta={{ label: "Compare Plans", href: "/pricing/" }}
  />
</MainLayout>
