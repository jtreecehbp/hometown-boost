---
import {getCollection,render} from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CTASection from '../../components/ui/CTASection.astro';
import {siteConfig} from '../../data/siteConfig';
export async function getStaticPaths(){const resources=await getCollection('resources',({data})=>data.draft!==true);return resources.map(resource=>({params:{slug:resource.id},props:{resource}}));}
const {resource}=Astro.props;
const {Content}=await render(resource);
const canonical=new URL(`/resources/${resource.id}/`,siteConfig.url).toString();
const articleSchema={'@context':'https://schema.org','@type':'Article',headline:resource.data.title,description:resource.data.description,mainEntityOfPage:canonical,publisher:{'@type':'Organization',name:'Hometown Boost'}};
---
<MainLayout title={`${resource.data.title} | Hometown Boost`} description={resource.data.description} canonical={canonical} ogType="article" schema={articleSchema}>
  <PageHero eyebrow={resource.data.category} title={resource.data.title} description={resource.data.description}><a class="text-link" href="/resources/" style="margin-top:25px">← All resources</a></PageHero>
  <Section><article class="prose"><Content/></article></Section>
  <CTASection title="Ready to put this into practice?"/>
</MainLayout>
