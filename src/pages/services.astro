---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import CTASection from "../components/ui/CTASection.astro";
import HandledForYouInfographic from "../components/infographics/HandledForYouInfographic.astro";
import LocalGrowthSystemInfographic from "../components/infographics/LocalGrowthSystemInfographic.astro";
import { pageMetadata } from "../data/metadata";
import { services } from "../data/services";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Website and local marketing services",
  provider: {
    "@type": "Organization",
    name: "Hometown Boost",
  },
  serviceType: "Website design, hosting, maintenance, local SEO foundation, Google Business Profile help, and Google Ads management",
};
---

<MainLayout title={pageMetadata.services.title} description={pageMetadata.services.description} schema={serviceSchema}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow">Services</span>
        <h1>Everything your local business needs to look professional and get found online.</h1>
        <p>From website design and hosting to local SEO foundations and Google Ads management, Hometown Boost gives hometown businesses a simpler way to handle digital marketing.</p>
        <div class="hero__actions">
          <Button href="/contact/" variant="secondary" size="lg">Check My Fit</Button>
          <Button href="/pricing/" size="lg">View Plans</Button>
        </div>
      </div>
      <div class="hero__media">
        <img src="/images/hometown-boost/services-local-visibility.svg" alt="Website, Google profile, reviews, local SEO, and ads connected in a local visibility flow." width="720" height="420" />
      </div>
    </div>
  </section>

  <Section title="Core services that help your business grow." align="center">
    <div class="grid grid--3">
      {services.map((service) => <ServiceCard {...service} />)}
    </div>
  </Section>

  <HandledForYouInfographic />

  <Section variant="light" title="A professional website without the big upfront bill.">
    <div class="split">
      <div>
        <p>Hometown Boost builds mobile-friendly websites with clean service pages, lead forms, click-to-call buttons, hosting included, maintenance included, and a monthly plan structure.</p>
        <ul class="check-list">
          <li>Mobile-friendly design</li>
          <li>Clear service pages</li>
          <li>Lead forms and click-to-call buttons</li>
          <li>Hosting included</li>
          <li>Maintenance included</li>
        </ul>
      </div>
      <img src="/images/hometown-boost/hero-hometown-business-growth.svg" alt="Local business website and storefront illustration." width="900" height="600" loading="lazy" decoding="async" />
    </div>
  </Section>

  <Section title="Built to support local search from day one.">
    <div class="split">
      <div>
        <p>Local SEO foundation means the basic website structure that helps customers and search engines understand what you do, where you work, and how to contact you.</p>
        <ul class="check-list">
          <li>Page titles and meta descriptions</li>
          <li>H1/H2 heading structure</li>
          <li>Service keywords used naturally</li>
          <li>Service-area references where appropriate</li>
          <li>Internal links between related pages</li>
          <li>Image alt text where helpful</li>
          <li>Contact details placed consistently</li>
          <li>Google Business Profile alignment guidance</li>
        </ul>
      </div>
      <div class="card local-seo-points">
        <div>
          <h3>Basic SEO setup</h3>
          <p>Page titles, descriptions, headings, and clear structure.</p>
        </div>
        <div>
          <h3>Service-area clarity</h3>
          <p>Help customers understand where you work and what you offer.</p>
        </div>
        <div>
          <h3>Google profile alignment</h3>
          <p>Your website and profile should tell a consistent story.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section variant="cream" title="Your website and Google profile should work together.">
    <div class="grid grid--3">
      <FeatureCard title="Business info consistency" description="Keep your name, phone, hours, and services aligned." icon="clipboard" />
      <FeatureCard title="Profile optimization" description="Plan-based help with services, categories, descriptions, and photos guidance." icon="storefront" />
      <FeatureCard title="Posts on higher plans" description="Growth and Leader include monthly Google Business Profile posting support." icon="calendar" />
    </div>
  </Section>

  <Section title="Make it easier for customers to trust you.">
    <div class="grid grid--4">
      <FeatureCard title="Review links" description="Direct happy customers to the right review link." icon="star" />
      <FeatureCard title="QR cards" description="Add a simple review card or QR code design when needed." icon="clipboard" />
      <FeatureCard title="Trust sections" description="Show real licenses, photos, and proof when the business provides them." icon="shield" />
      <FeatureCard title="Before/after photos" description="Use real project photos if the client has them." icon="browser" />
    </div>
  </Section>

  <Section variant="light" title="Want leads faster? Add Google Search Ads." description="We can manage simple Google Search campaigns when your website or landing page is ready for traffic.">
    <div class="actions">
      <Button href="/google-ads/" variant="secondary">Learn About Google Ads</Button>
    </div>
  </Section>

  <LocalGrowthSystemInfographic />

  <CTASection
    title="Start with the foundation, then grow from there."
    primaryCta={{ label: "Check My Fit", href: "/contact/", variant: "secondary" }}
    secondaryCta={{ label: "View Plans", href: "/pricing/" }}
  />
</MainLayout>
