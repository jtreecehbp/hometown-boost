---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import SceneWindow from '../components/SceneWindow.astro';
import WebsiteDemo from '../components/WebsiteDemo.astro';
import CTASection from '../components/ui/CTASection.astro';
import {services} from '../data/services';
import {pageMetadata} from '../data/metadata';
---
<MainLayout {...pageMetadata.services}>
  <section class="page-hero"><div class="container page-intro"><div><span class="eyebrow">MORE THAN A WEBSITE BUILD.</span><h1>Look professional.<br />Make it easy to call.</h1><p>Give customers a clear view of your services and an easy way to reach you. We handle the website, hosting, and ongoing care, with local search support based on your plan.</p><div class="actions"><Button href="/contact/">Find my plan <span aria-hidden="true">↗</span></Button><Button href="/pricing/" variant="outline">Compare plans</Button></div></div><SceneWindow/></div></section>
  <Section eyebrow="FROM FIRST CLICK TO FIRST CALL." title="The tools to help customers choose you.">
    {services.map((service,i)=><article class="editorial-row"><span class="editorial-row__number">0{i+1} /</span><h3>{service.title}</h3><div><p>{service.details}</p><a class="text-link" href={i===5?'/google-ads/':'/pricing/'}>{i===5?'Explore Google Ads':'Compare what’s included'} <span aria-hidden="true">↗</span></a></div></article>)}
  </Section>
  <section class="section dark-section" id="websites"><div class="container service-showcase"><div><span class="eyebrow">YOUR BEST FIRST IMPRESSION.</span><h2 style="margin:20px 0">A good website should earn its place in your business.</h2><p>We make your services clear, your service area easy to find, and the next step simple. Your real photos, reviews, and credentials add the reasons to trust you.</p><ul class="check-list"><li>Clear service information and contact paths</li><li>Layouts built for phones and larger screens</li><li>Your business details, accurately presented</li><li>Hosting, SSL, and plan-based updates</li></ul><Button href="/pricing/" variant="secondary">Find your website plan <span aria-hidden="true">↗</span></Button></div><WebsiteDemo/></div></section>
  <Section id="visibility" eyebrow="MAKE YOUR BUSINESS EASIER TO FIND." title="Clear information. More reasons to get in touch.">
    <div class="grid grid--3"><article class="card"><span class="eyebrow">YOUR WEBSITE</span><h3>Say what you do.<br />Show where you work.</h3><p>Clear service pages and search-friendly structure help customers and search engines understand what you offer and where you work.</p></article><article class="card"><span class="eyebrow">YOUR GOOGLE PROFILE</span><h3>Keep your business information in sync.</h3><p>Starter includes a profile checkup. Growth and Leader add optimization and monthly posting support.</p></article><article class="card"><span class="eyebrow">YOUR REPUTATION</span><h3>Let your real work do the talking.</h3><p>Growth and Leader include review link and QR setup to make requesting feedback easier, plus room to feature your real reviews and work.</p></article></div>
    <p class="note" style="margin-top:25px">Local SEO helps search engines understand your business. Rankings, traffic, and lead volume depend on your market and are not guaranteed.</p>
  </Section><CTASection/>
</MainLayout>
