---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import IndustryCard from "../components/ui/IndustryCard.astro";
import PricingCard from "../components/ui/PricingCard.astro";
import FAQAccordion from "../components/ui/FAQAccordion.astro";
import CTASection from "../components/ui/CTASection.astro";
import Icon from "../components/icons/Icon.astro";
import HowItWorksInfographic from "../components/infographics/HowItWorksInfographic.astro";
import WebsiteJobsInfographic from "../components/infographics/WebsiteJobsInfographic.astro";
import LocalGrowthSystemInfographic from "../components/infographics/LocalGrowthSystemInfographic.astro";
import MonthlyValueFlywheel from "../components/infographics/MonthlyValueFlywheel.astro";
import ComparisonInfographic from "../components/infographics/ComparisonInfographic.astro";
import { pageMetadata } from "../data/metadata";
import { googleAdsPricing, pricingPlans } from "../data/pricingPlans";
import { industries } from "../data/industries";
import { selectFaqs } from "../data/faqs";

const homeFaqs = selectFaqs([
  "Are there setup fees?",
  "Why are there minimum terms?",
  "Can I upgrade later?",
  "Are results guaranteed?",
  "Is hosting included?",
]);

const litePlan = pricingPlans[0];
const startingPriceMonthly = litePlan.priceLabel.replace("/mo", "/month");

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Websites and local marketing for hometown businesses",
  provider: {
    "@type": "Organization",
    name: "Hometown Boost",
  },
  areaServed: "United States",
  description:
    "Professional websites, hosting, maintenance, local SEO foundations, Google Business Profile help, and optional Google Ads management for local businesses.",
};
---

<MainLayout title={pageMetadata.home.title} description={pageMetadata.home.description} schema={serviceSchema}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <h1>Done-for-you websites for local service businesses that need more calls.</h1>
        <p>
          No setup fees. Plans start at {startingPriceMonthly} with hosting, maintenance, local SEO foundations, and practical marketing support handled for you.
        </p>
        <div class="hero__actions">
          <Button href="/contact/" variant="secondary" size="lg">Check My Fit</Button>
          <Button href="/pricing/" size="lg">View Plans</Button>
        </div>
        <p class="hero__microcopy">Tell us your business type, service area, and current website situation. We will point you toward the right plan without pressure.</p>
        <ul class="hero__bullets" aria-label="Hometown Boost highlights">
          <li><span class="icon-circle"><Icon name="dollar" /></span>No setup fees</li>
          <li><span class="icon-circle"><Icon name="cloud" /></span>Hosting and maintenance included</li>
          <li><span class="icon-circle"><Icon name="storefront" /></span>Built for local service businesses</li>
        </ul>
      </div>
      <div class="hero__media">
        <img src="/images/hometown-boost/hero-hometown-business-growth.svg" alt="Local storefronts, website screens, and a service truck showing hometown business growth." width="900" height="600" />
      </div>
    </div>
  </section>

  <Section variant="light">
    <ul class="value-strip" aria-label="Core value points">
      <li><span class="icon-circle"><Icon name="dollar" /></span>Starting at {litePlan.priceLabel}</li>
      <li><span class="icon-circle"><Icon name="shield" /></span>No setup fees</li>
      <li><span class="icon-circle"><Icon name="phone" /></span>Mobile-friendly</li>
      <li><span class="icon-circle"><Icon name="cloud" /></span>Hosting included</li>
      <li><span class="icon-circle"><Icon name="search" /></span>Local SEO foundation</li>
      <li><span class="icon-circle"><Icon name="megaphone" /></span>Google Ads available</li>
    </ul>
  </Section>

  <Section
    title="Your business should look as good online as it does in real life."
    description="Many local businesses are great at what they do, but their website is outdated, missing, hard to update, or not built to turn visitors into calls. Hometown Boost gives you a simple monthly way to get a professional online presence without a big upfront bill."
  >
    <div class="grid grid--3">
      <FeatureCard title="Outdated website" description="Old design, poor mobile experience, and pages that are hard to update." icon="browser" tone="orange" />
      <FeatureCard title="Hard to get found" description="Customers search online, but your business may not show up clearly." icon="search" />
      <FeatureCard title="Too much tech hassle" description="You do not have time to manage hosting, updates, SEO, and forms." icon="wrench" />
    </div>
  </Section>

  <Section variant="cream" title="A clear starting point before you commit." align="center">
    <div class="grid grid--3">
      <FeatureCard title="Quick fit review" description="We review your business type, service area, current website, and goals before recommending a plan." icon="search" />
      <FeatureCard title="Public pricing" description="Plans, minimum terms, and what is included are published before you reach out." icon="dollar" />
      <FeatureCard title="Honest expectations" description="No fake guarantees, invented proof, or pressure to buy services you are not ready for." icon="shield" />
    </div>
  </Section>

  <WebsiteJobsInfographic />

  <Section variant="light" eyebrow="Who We Help" title="Built for the businesses that keep hometowns moving." align="center">
    <div class="grid grid--4">
      {industries.slice(0, 12).map((industry) => <IndustryCard {...industry} />)}
    </div>
    <div class="actions" style="justify-content: center;">
      <Button href="/industries/" variant="outline">See Industries</Button>
      <Button href="/how-it-works/" variant="ghost">See How It Works</Button>
    </div>
  </Section>

  <Section eyebrow="Plans" title="Simple monthly plans. No setup fees." description="Growth is the recommended plan for local service businesses that want more calls and better local visibility." align="center">
    <div class="grid grid--4 pricing-grid">
      {pricingPlans.map((plan) => <PricingCard plan={plan} featureLimit={5} />)}
    </div>
    <div class="actions" style="justify-content: center;">
      <Button href="/pricing/" variant="outline">Compare all plans</Button>
    </div>
  </Section>

  <HowItWorksInfographic />

  <Section title="More than a website file sitting online." description="Your monthly plan includes the essentials that keep your site live, secure, updated, and ready for local customers.">
    <MonthlyValueFlywheel />
  </Section>

  <Section variant="light" title="A simpler path than DIY. A lower-friction option than a big agency." align="center">
    <ComparisonInfographic />
    <div class="actions" style="justify-content: center;">
      <Button href="/pricing/" variant="outline">Compare Plans</Button>
    </div>
  </Section>

  <LocalGrowthSystemInfographic />

  <Section variant="cream" title="Need leads faster? Add Google Ads management." description="For businesses ready to drive more search traffic, Hometown Boost can manage simple Google Search campaigns focused on calls and form leads.">
    <div class="split">
      <div class="card">
        <span class="eyebrow">Optional Add-on</span>
        <h3 style="margin-top: 0.8rem;">{googleAdsPricing.formulaLabel}</h3>
        <p>{googleAdsPricing.note} Hometown Boost charges a separate management fee.</p>
        <Button href="/contact/?service=google-ads" variant="secondary">Ask About Google Ads</Button>
      </div>
      <img src="/images/hometown-boost/ads-local-search.svg" alt="Search ads and call lead graphic for a local business." width="720" height="420" loading="lazy" decoding="async" />
    </div>
  </Section>

  <Section title="Frequently asked questions" align="center">
    <FAQAccordion items={homeFaqs} />
    <div class="actions" style="justify-content: center;">
      <Button href="/faq/" variant="outline">View all FAQs</Button>
    </div>
  </Section>

  <CTASection
    title="Ready to look better online without a big upfront bill?"
    description="View the monthly plans or tell us about your business so we can point you toward the right starting point."
    primaryCta={{ label: "Check My Fit", href: "/contact/", variant: "secondary" }}
    secondaryCta={{ label: "View Plans", href: "/pricing/" }}
  />
</MainLayout>
