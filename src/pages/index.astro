---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import LaunchScene from '../components/LaunchScene.astro';
import PricingCard from '../components/ui/PricingCard.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import Icon from '../components/icons/Icon.astro';
import {pricingPlans} from '../data/pricingPlans';
import {selectFaqs} from '../data/faqs';
import {projects} from '../data/projects';
import '../styles/launch.css';
const faqs=selectFaqs(['Are there setup fees?','Why are there minimum terms?','Is hosting included?','Are results guaranteed?']);
const chapters=[['home','Your hometown'],['what-you-get','What you get'],['work','Real work'],['plans','Your plan'],['questions','Good questions'],['ready','Let’s launch']];
const corePlans=pricingPlans.filter(plan=>plan.id!=='marketing');
const marketing=pricingPlans.find(plan=>plan.id==='marketing')!;
const serviceSchema={'@context':'https://schema.org','@type':'Service',name:'Websites and local marketing for hometown businesses',provider:{'@type':'Organization',name:'Hometown Boost'},areaServed:'United States',description:'Monthly website design, hosting, maintenance, local SEO foundations, Google Business Profile support, and optional Google Search Ads management.'};
---
<MainLayout title="Hometown Boost | Websites & Local Marketing" description={`Website and Google Business Profile management from $${pricingPlans[0].price}/month. Add supported integrations and automated follow-up with Hometown Connect. $0 setup; minimum terms apply.`} immersive schema={serviceSchema}>
  <div class="launch-world" data-launch-world>
    <LaunchScene />
    <nav class="launch-chapters" aria-label="Homepage sections">
      {chapters.map(([id,label],i)=><a href={`#${id}`} aria-label={label} data-chapter-link={i} aria-current={i===0?'step':undefined}><span class="launch-chapters__dot"></span><span class="launch-chapters__label">{label}</span></a>)}
    </nav>
    <div class="launch-controls" data-launch-controls hidden><span class="launch-controls__chapter" data-launch-label>Your hometown</span><span class="launch-controls__divider"></span><button type="button" data-launch-pause aria-pressed="false"><span class="launch-controls__text">Pause motion</span><span aria-hidden="true">Ⅱ</span></button></div>

    <section class="flight-chapter launch-hero" id="home" data-flight-stop="0">
      <div class="container flight-chapter__inner">
        <div class="launch-copy">
          <span class="eyebrow">WEBSITES + LOCAL MARKETING</span>
          <h1>Big things<br />start <em>local.</em></h1>
          <p>Help customers find you and choose your business. Your website, Google Business Profile, and ongoing care—all in one monthly plan.</p>
          <div class="actions"><Button href="/contact/" variant="secondary" size="lg">Get my free recommendation <span aria-hidden="true">↗</span></Button><a class="launch-text-link" href="#plans">See plans <span aria-hidden="true">↓</span></a></div>
          <p class="launch-price">From <strong>${pricingPlans[0].price}/month</strong> · $0 setup<br /><a href="/pricing/">Compare plans and minimum terms.</a></p>
        </div>
      </div>
      <div class="container launch-hero__bottom"><a class="launch-scroll" href="#what-you-get"><span class="launch-scroll__line" aria-hidden="true"></span>Scroll to launch <span aria-hidden="true">↓</span></a><p>MADE FOR THE BUSINESSES<br />THAT MAKE A HOMETOWN.</p></div>
    </section>

    <section class="film-beat" data-flight-cue="0.24" aria-label="Liftoff">
      <div class="container"><p class="film-beat__caption">Small town.<br /><em>Big lift.</em></p></div>
    </section>

    <section class="flight-chapter" id="what-you-get" data-flight-stop="1">
      <div class="container flight-chapter__inner"><div class="launch-copy launch-copy--panel">
        <span class="eyebrow">WHAT YOU GET</span>
        <h2>Look good.<br />Get found.<br /><em>Stay that way.</em></h2>
        <p>One monthly plan covers your website, your Google Business Profile, and the care that keeps them working.</p>
        <ul class="launch-offer">
          <li><Icon name="browser"/><div><h3>A website that earns the call</h3><p>Clear service pages, real photos, and easy ways to call or send a request.</p><a class="launch-text-link" href="/services/#websites">What goes into your website <span aria-hidden="true">↗</span></a></div></li>
          <li><Icon name="map-pin"/><div><h3>Easier to find nearby</h3><p>Your website, Google Business Profile, and reviews working together around accurate, useful information.</p><a class="launch-text-link" href="/services/#visibility">Build your local presence <span aria-hidden="true">↗</span></a></div></li>
          <li><Icon name="wrench"/><div><h3>Upkeep handled for you</h3><p>Hosting, updates, and care after launch. With Connect, we also link your business tools and follow-up.</p><a class="launch-text-link" href="/how-it-works/">See how it all works <span aria-hidden="true">↗</span></a></div></li>
        </ul>
      </div></div>
    </section>

    <section class="film-beat film-beat--clouds" data-flight-cue="0.525" aria-label="Above the clouds">
      <div class="container"><p class="film-beat__caption">A whole new<br /><em>point of view.</em></p></div>
    </section>

    <section class="flight-chapter launch-work" id="work" data-flight-stop="2">
      <div class="container flight-chapter__inner"><div class="launch-copy launch-copy--panel launch-copy--work">
        <span class="eyebrow">REAL WORK, LIVE TODAY</span>
        <h2>Websites for<br /><em>real local businesses.</em></h2>
        <div class="launch-projects">
          {projects.map(project=><article class="launch-project">
            <a class="launch-project__shots" href={project.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              <span class="device device--laptop"><img src={`/images/work/${project.shot}-desktop.webp`} alt="" width="960" height="600" loading="lazy" decoding="async" /></span>
              <span class="device device--phone"><img src={`/images/work/${project.shot}-phone.webp`} alt="" width="360" height="778" loading="lazy" decoding="async" /></span>
            </a>
            <div class="launch-project__copy"><span class="eyebrow">{project.category}</span><h3>{project.name}</h3><p>{project.copy}</p><a class="launch-text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit the live website <span aria-hidden="true">↗</span><span class="sr-only"> (opens a new tab)</span></a></div>
          </article>)}
        </div>
        <div class="launch-meet"><p><strong>Hi, I’m Jordan.</strong> You work directly with me to choose the plan, review the website, and decide what needs attention next.</p><a class="launch-text-link" href="/about/">Meet Jordan <span aria-hidden="true">↗</span></a></div>
      </div></div>
    </section>

    <section class="flight-chapter flight-chapter--wide launch-plans" id="plans" data-flight-stop="3">
      <div class="container">
        <div class="launch-section-heading"><span class="eyebrow">CHOOSE YOUR PLAN</span><h2>Your website.<br /><em>One clear monthly plan.</em></h2><p>Start with Foundation for your website, Google profile, and reviews. Choose Connect to link your business tools and automate follow-up.</p></div>
        <div class="grid pricing-grid grid--2">{corePlans.map(plan=><PricingCard plan={plan} featureLimit={5}/>)}</div>
        <a class="launch-upgrade" href="/google-ads/"><span class="launch-upgrade__tag">UPGRADE</span><span class="launch-upgrade__copy"><strong>Add Google Ads with {marketing.shortName}</strong><span>${marketing.price}/month · {marketing.priceNote}</span></span><span class="launch-upgrade__arrow" aria-hidden="true">↗</span></a>
        <p class="launch-plans__note">$0 setup. A 12-month minimum applies to each plan. <a href="/pricing/#compare">Compare every feature ↗</a></p>
      </div>
    </section>

    <section class="flight-chapter flight-chapter--wide launch-questions" id="questions" data-flight-stop="4">
      <div class="container faq-split"><div><span class="eyebrow">A LITTLE CLARITY BEFORE LIFTOFF.</span><h2>Good questions.<br /><em>Straight answers.</em></h2><p>Know what’s included, how the commitment works, and what to expect.</p><a class="launch-text-link" href="/faq/">More questions answered <span aria-hidden="true">↗</span></a></div><FAQAccordion items={faqs}/></div>
    </section>

    <section class="film-beat film-beat--homecoming" data-flight-cue="0.935" aria-label="A view back toward home">
      <div class="container"><p class="film-beat__caption">It all comes<br /><em>back to local.</em></p></div>
    </section>

    <section class="flight-chapter launch-finale" id="ready" data-flight-stop="5">
      <div class="container flight-chapter__inner"><div class="launch-copy">
        <span class="eyebrow">LET’S PUT YOUR BUSINESS TO WORK ONLINE</span><h2>Ready for<br /><em>a better website?</em></h2>
        <p>Tell us what you do and what you want to improve. We’ll recommend a plan and explain the scope before you commit.</p>
        <div class="actions"><Button href="/contact/" variant="secondary" size="lg">Get my free recommendation <span aria-hidden="true">↗</span></Button></div>
        <p class="launch-smallprint">No obligation. A recommendation sent by Jordan.</p><a class="launch-text-link" href="/about/">Meet Jordan &amp; see live project examples ↗</a>
        <a class="launch-replay" href="#home">Back to the beginning <span aria-hidden="true">↑</span></a>
      </div></div>
    </section>
  </div>
</MainLayout>
