---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import LaunchScene from '../components/LaunchScene.astro';
import PricingCard from '../components/ui/PricingCard.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import Icon from '../components/icons/Icon.astro';
import {pricingPlans} from '../data/pricingPlans';
import {selectFaqs} from '../data/faqs';
import '../styles/launch.css';
const faqs=selectFaqs(['Are there setup fees?','Why are there minimum terms?','Is hosting included?','Can I upgrade later?','Are results guaranteed?']);
const chapters=[['home','Your hometown'],['website','Your website'],['visibility','Get found'],['support','Keep growing'],['plans','Your plan'],['questions','Good questions'],['ready','Let’s launch']];
const serviceSchema={'@context':'https://schema.org','@type':'Service',name:'Websites and local marketing for hometown businesses',provider:{'@type':'Organization',name:'Hometown Boost'},areaServed:'United States',description:'Monthly website design, hosting, maintenance, local SEO foundations, Google Business Profile support, and optional Google Search Ads management.'};
---
<MainLayout title="Hometown Boost | Big Things Start Local" description="Done-for-you websites and local marketing for the businesses that make a hometown. Plans from $99/month with $0 setup, hosting, and maintenance included." immersive schema={serviceSchema}>
  <div class="launch-world" data-launch-world>
    <LaunchScene />
    <nav class="launch-chapters" aria-label="Homepage sections">
      {chapters.map(([id,label],i)=><a href={`#${id}`} aria-label={label} data-chapter-link={i} aria-current={i===0?'step':undefined}><span class="launch-chapters__dot"></span><span class="launch-chapters__label">{label}</span></a>)}
    </nav>
    <div class="launch-controls" data-launch-controls hidden><span class="launch-controls__chapter" data-launch-label>Your hometown</span><span class="launch-controls__divider"></span><button type="button" data-launch-pause aria-pressed="false">Pause motion <span aria-hidden="true">Ⅱ</span></button></div>
    <section class="flight-chapter launch-hero" id="home" data-flight-stop="0">
      <div class="container flight-chapter__inner">
        <div class="launch-copy">
          <span class="eyebrow">WEBSITES + LOCAL MARKETING</span>
          <h1>Big things<br />start <em>local.</em></h1>
          <p>You take care of your customers. We build your website and local presence—so more of your neighbors can find you.</p>
          <div class="actions"><Button href="/contact/" variant="secondary" size="lg">Find my plan <span aria-hidden="true">↗</span></Button><a class="launch-text-link" href="#plans">Explore plans <span aria-hidden="true">↗</span></a></div>
          <p class="launch-price">From <strong>$99/month</strong> · $0 setup<br /><a href="/pricing/">Clear plans. Clear minimum terms.</a></p>
        </div>
      </div>
      <div class="container launch-hero__bottom"><a class="launch-scroll" href="#website"><span class="launch-scroll__line" aria-hidden="true"></span>Scroll to launch <span aria-hidden="true">↓</span></a><p>MADE FOR THE BUSINESSES<br />THAT MAKE A HOMETOWN.</p></div>
    </section>
    <section class="flight-chapter" id="website" data-flight-stop="1">
      <div class="container flight-chapter__inner"><div class="launch-copy launch-copy--panel">
        <span class="eyebrow">01 / A STRONGER START</span>
        <h2>Good at what you do?<br /><em>Let it show.</em></h2>
        <p>A professional website that explains your services, shows your real work, and makes it easy to get in touch. Built around your business, from the first page to the final detail.</p>
        <ul class="launch-features"><li><Icon name="browser"/><span>Designed for your business</span></li><li><Icon name="phone"/><span>Easy to use on every screen</span></li><li><Icon name="mail"/><span>A clear path to calls and inquiries</span></li></ul>
        <a class="launch-text-link" href="/services/#websites">What goes into your website <span aria-hidden="true">↗</span></a>
      </div></div>
    </section>
    <section class="film-beat" data-flight-cue="0.24" aria-label="Liftoff">
      <div class="container"><p class="film-beat__caption">Small town.<br /><em>Big lift.</em></p></div>
    </section>
    <section class="flight-chapter" id="visibility" data-flight-stop="2">
      <div class="container flight-chapter__inner"><div class="launch-copy launch-copy--panel">
        <span class="eyebrow">02 / A LITTLE MORE LIFT</span>
        <h2>Your next customer<br />is <em>closer than you think.</em></h2>
        <p>Connect your website, service area, and Google Business Profile. Give the people searching nearby a clearer picture of what you do—and why they should call.</p>
        <div class="launch-detail"><span>LOCAL SEARCH, WORKING TOGETHER</span><p>Website foundations · Google profile support · Review tools</p></div>
        <a class="launch-text-link" href="/services/#visibility">Build your local presence <span aria-hidden="true">↗</span></a>
        <p class="launch-smallprint">Support varies by plan. Search rankings and lead volume are not guaranteed.</p>
      </div></div>
    </section>
    <section class="film-beat film-beat--clouds" data-flight-cue="0.525" aria-label="Above the clouds">
      <div class="container"><p class="film-beat__caption">A whole new<br /><em>point of view.</em></p></div>
    </section>
    <section class="flight-chapter" id="support" data-flight-stop="3">
      <div class="container flight-chapter__inner"><div class="launch-copy launch-copy--panel">
        <span class="eyebrow">03 / BUILT TO KEEP GOING</span>
        <h2>You run the business.<br />We’ll handle <em>the upkeep.</em></h2>
        <p>Launch day is the beginning. Hosting, SSL, maintenance, and updates matched to your plan help keep your website ready for what comes next.</p>
        <div class="launch-process"><div><span>01</span><strong>Tell us your story.</strong></div><div><span>02</span><strong>We build. You review.</strong></div><div><span>03</span><strong>Launch with ongoing support.</strong></div></div>
        <a class="launch-text-link" href="/how-it-works/">See how it all works <span aria-hidden="true">↗</span></a>
      </div></div>
    </section>
    <section class="flight-chapter flight-chapter--wide launch-plans" id="plans" data-flight-stop="4">
      <div class="container">
        <div class="launch-section-heading"><span class="eyebrow">YOUR BUSINESS. YOUR NEXT CHAPTER.</span><h2>Big possibilities.<br /><em>A down-to-earth plan.</em></h2><p>Every plan includes your website, hosting, SSL, and maintenance. Start where you are, with room to grow.</p></div>
        <div class="grid grid--4 pricing-grid">{pricingPlans.map(plan=><PricingCard plan={plan} featureLimit={5}/>)}</div>
        <p class="launch-plans__note">Your build and support are spread across your plan’s minimum term. <a href="/pricing/#compare">Compare every feature ↗</a></p>
        <div class="launch-ads-note"><span>READY FOR MORE SEARCH TRAFFIC?</span><a href="/google-ads/">Explore optional Google Ads management <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <section class="flight-chapter flight-chapter--wide launch-questions" id="questions" data-flight-stop="5">
      <div class="container faq-split"><div><span class="eyebrow">A LITTLE CLARITY BEFORE LIFTOFF.</span><h2>Good questions.<br /><em>Straight answers.</em></h2><p>Know what’s included, how the commitment works, and what to expect.</p><a class="launch-text-link" href="/faq/">More questions answered <span aria-hidden="true">↗</span></a></div><FAQAccordion items={faqs}/></div>
    </section>
    <section class="film-beat film-beat--homecoming" data-flight-cue="0.935" aria-label="A view back toward home">
      <div class="container"><p class="film-beat__caption">It all comes<br /><em>back to local.</em></p></div>
    </section>
    <section class="flight-chapter launch-finale" id="ready" data-flight-stop="6">
      <div class="container flight-chapter__inner"><div class="launch-copy">
        <span class="eyebrow">HOMETOWN ROOTS. ROOM TO GROW.</span><h2>Big things<br /><em>start local.</em></h2>
        <p>You’ve built something worth finding. Let’s help your hometown see it.</p>
        <div class="actions"><Button href="/contact/" variant="secondary" size="lg">Let’s talk about your business <span aria-hidden="true">↗</span></Button></div>
        <p class="launch-smallprint">No obligation. A clear recommendation for your next step.</p>
        <a class="launch-replay" href="#home">Back to the beginning <span aria-hidden="true">↑</span></a>
      </div></div>
    </section>
  </div>
</MainLayout>
