---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import AdsPricingTable from '../components/ui/AdsPricingTable.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import CTASection from '../components/ui/CTASection.astro';
import {selectFaqs} from '../data/faqs';
import {pageMetadata} from '../data/metadata';
import {googleAdsPricing} from '../data/pricingPlans';
const example=googleAdsPricing.examples[1];
const included=[['Reach the right searches','One primary Google Search campaign built around your main service or priority offer, targeted to the area you serve.'],['Make every ad clear','Keyword setup, negative keywords to filter irrelevant searches, and ad copy that explains your service and gives customers a clear next step.'],['Track and improve the campaign','Basic conversion tracking where possible, monthly optimization, and a report covering ad spend, traffic, and tracked actions such as inquiries.']];
---
<MainLayout {...pageMetadata.googleAds}>
  <PageHero eyebrow="SHOW UP WHEN CUSTOMERS ARE SEARCHING." title="Put your services in front of local customers." description="Reach people searching for the work you do, in the area you serve. We manage your Google Search campaign and direct customers to a page where they can learn more and contact you."><div class="actions"><Button href="/contact/?service=google-ads">Ask about Google Ads <span aria-hidden="true">↗</span></Button><Button href="#ads-pricing" variant="outline">See ad management pricing</Button></div></PageHero>
  <Section id="ads-pricing"><div class="split"><div><span class="eyebrow">CLEAR COSTS, BEFORE YOU START.</span><h2 style="margin:20px 0">{googleAdsPricing.baseManagementFeeLabel}.<br />Plus {googleAdsPricing.adSpendPercentageLabel} of ad spend.</h2><p>You pay your ad budget directly to Google. Our separate management fee covers the campaign work. Website plan fees are separate.</p><p class="note" style="margin-top:20px">For example: a {example.adSpend} monthly ad budget has a {example.managementFee} management fee, for a {example.totalInvestment} total monthly investment in ads.</p></div><AdsPricingTable/></div></Section>
  <Section variant="light" eyebrow="WHAT YOUR MANAGEMENT FEE COVERS." title="Campaign setup, care, and clear reporting.">{included.map(([title,copy],i)=><article class="editorial-row"><span class="editorial-row__number">0{i+1} /</span><h3>{title}</h3><p>{copy}</p></article>)}</Section>
  <Section><div class="split"><div><span class="eyebrow">MAKE SURE YOUR BUSINESS IS READY.</span><h2 style="margin:20px 0">Is Google Ads a good fit?</h2><p>Paid search needs more than an ad. Before starting, consider your budget, the value of a new customer, and how you’ll respond when someone gets in touch.</p><ul class="check-list"><li>A realistic ad budget and time to learn what works</li><li>Services with enough value to support paid search</li><li>A website with clear services and contact options</li><li>Capacity to respond to new inquiries</li></ul><p class="note">A three-month testing period is recommended. Results depend on your market, budget, offer, competition, and follow-up; leads and revenue are not guaranteed.</p></div><div class="card"><h3>What’s outside this offer?</h3><ul class="check-list x-list"><li>Ad spend, paid separately to Google</li><li>Meta, TikTok, display, video, or other ad platforms</li><li>Advanced funnels and CRM automations</li><li>Daily hands-on account management</li><li>Landing page design, unless in your website plan or separately quoted</li><li>Guaranteed leads, cost per lead, or revenue</li></ul><a class="text-link" href="/pricing/">Compare website plans ↗</a></div></div></Section>
  <Section variant="light" title="Google Ads, explained." align="center"><FAQAccordion items={selectFaqs(['How does Google Ads pricing work?','Who pays the Google Ads budget?','Do you guarantee Google Ads results?','What kind of ads do you manage?'])}/></Section>
  <CTASection eyebrow="FOCUSED GOOGLE SEARCH CAMPAIGNS" title="Find out if ads fit your business." description="Tell us about your services, service area, and goals. We’ll help you assess whether Google Search Ads are a sensible next step." primaryCta={{label:'Ask about Google Ads',href:'/contact/?service=google-ads'}} note={`${googleAdsPricing.formulaLabel}. Ad spend is separate.`}/>
</MainLayout>
