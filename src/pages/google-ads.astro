---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import AdsPricingTable from '../components/ui/AdsPricingTable.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import CTASection from '../components/ui/CTASection.astro';
import {selectFaqs} from '../data/faqs';
import {pageMetadata} from '../data/metadata';
const included=[['A focused starting point','One primary Google Search campaign around your main service or highest-priority offer, with location targeting for the area you actually serve.'],['The details that make an ad useful','Keyword setup, negative keywords, and practical ad copy focused on your services, service area, and clear contact options.'],['A way to learn what’s working','Basic conversion tracking where possible, monthly optimization, and a straightforward report covering spend, traffic, and tracked actions.']];
---
<MainLayout {...pageMetadata.googleAds}>
  <PageHero eyebrow="SHOW UP WHEN THEY’RE LOOKING." title="Your next customer may be one search away." description="Reach people actively searching for your services. We manage focused Google Search campaigns that send them to a website ready for the conversation."><div class="actions"><Button href="/contact/?service=google-ads">Let’s talk Google Ads <span aria-hidden="true">↗</span></Button><Button href="#ads-pricing" variant="outline">See the pricing</Button></div></PageHero>
  <Section id="ads-pricing"><div class="split"><div><span class="eyebrow">CLEAR COSTS, BEFORE YOU START.</span><h2 style="margin:20px 0">$150/month.<br />Plus 15% of ad spend.</h2><p>You pay your ad budget directly to Google. Our separate management fee covers the campaign work. Website plan fees are separate.</p><p class="note" style="margin-top:20px">For example: a $500 monthly ad budget has a $225 management fee, for a $725 total monthly investment in ads.</p></div><AdsPricingTable/></div></Section>
  <Section variant="light" eyebrow="WHAT WE TAKE CARE OF." title="Focused campaigns. Practical support.">{included.map(([title,copy],i)=><article class="editorial-row"><span class="editorial-row__number">0{i+1} /</span><h3>{title}</h3><p>{copy}</p></article>)}</Section>
  <Section><div class="split"><div><span class="eyebrow">GET THE FOUNDATION RIGHT.</span><h2 style="margin:20px 0">Ready for more inquiries?</h2><p>Ads work best when your business has a clear service offer, a website or landing page ready for traffic, and someone available to answer calls or follow up.</p><ul class="check-list"><li>A realistic ad budget and time to learn what works</li><li>Jobs with enough value to support paid search</li><li>A website with clear services and contact options</li><li>Capacity to respond to new inquiries</li></ul><p class="note">A three-month testing period is recommended. Results depend on your market, budget, offer, competition, and follow-up; leads and revenue are not guaranteed.</p></div><div class="card"><h3>What’s outside this offer?</h3><ul class="check-list x-list"><li>Ad spend, paid separately to Google</li><li>Meta, TikTok, display, video, or other ad platforms</li><li>Advanced funnels and CRM automations</li><li>Daily hands-on account management</li><li>Landing page design, unless in your website plan or separately quoted</li><li>Guaranteed leads, cost per lead, or revenue</li></ul><a class="text-link" href="/pricing/">Start with your website plan ↗</a></div></div></Section>
  <Section variant="light" title="A few good questions about ads." align="center"><FAQAccordion items={selectFaqs(['How does Google Ads pricing work?','Who pays the Google Ads budget?','Do you guarantee Google Ads results?','What kind of ads do you manage?'])}/></Section>
  <CTASection title="Let’s see if ads make sense for you." description="Tell us about your services and market. We’ll help you decide whether you’re ready for paid search." primaryCta={{label:'Ask about Google Ads',href:'/contact/?service=google-ads'}}/>
</MainLayout>
