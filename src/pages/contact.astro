---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import SceneWindow from '../components/SceneWindow.astro';
import {pageMetadata} from '../data/metadata';
import {planInterestOptions} from '../data/pricingPlans';
const serverDelivery=import.meta.env.PUBLIC_FORM_DELIVERY==='server';
const formEnabled=serverDelivery||import.meta.env.NETLIFY==='true'||import.meta.env.PUBLIC_FORM_DELIVERY==='netlify';
const formEndpoint=serverDelivery?'/api/contact':'/';
---
<MainLayout {...pageMetadata.contact}>
  <div class="container contact-layout">
    <div class="contact-intro"><span class="eyebrow">A GOOD NEXT STEP STARTS WITH HELLO.</span><h1>Let’s put your business on the map.</h1><p>Tell us a little about your business. We’ll take a look and help you find the right starting point.</p>
      <SceneWindow/>
      <div class="contact-expectations"><div><span>01 /</span><div><strong>You share the basics.</strong><p>Where you work and what you need.</p></div></div><div><span>02 /</span><div><strong>We review the fit.</strong><p>Your website, goals, and plan options.</p></div></div><div><span>03 /</span><div><strong>You get a clear next step.</strong><p>A recommendation, without obligation.</p></div></div></div>
      <p class="note">Plans from <strong>$99/month</strong> with <strong>$0 setup</strong>.<br />Minimum terms apply. <a class="text-link" href="/pricing/">See plans and commitments ↗</a></p>
      <p style="margin-top:30px;font-size:14px">Prefer to say hello by email?<br /><a class="text-link" href="mailto:hello@hometownboost.com">hello@hometownboost.com ↗</a></p>
    </div>
    <form class="lead-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={serverDelivery?'/api/contact':'/thank-you/'} data-form-endpoint={formEndpoint} data-form-enabled={String(formEnabled)}>
      <input type="hidden" name="form-name" value="contact"/>
      <p class="honeypot" aria-hidden="true"><label>Leave this field blank<input name="bot-field" tabindex="-1" autocomplete="off"/></label></p>
      {['landing_page','source_url','referrer','utm_source','utm_medium','utm_campaign','utm_content','utm_term'].map(name=><input type="hidden" name={name} id={name}/>)}
      <h2>A little about your business.</h2><p>Four quick details to get the conversation started.</p>
      <p class="contact-context" data-source-message hidden></p>
      <div class="form-grid">
        <div class="form-field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="First and last name"/></div>
        <div class="form-field"><label for="businessName">Business name *</label><input id="businessName" name="businessName" autocomplete="organization" required maxlength="160" placeholder="Your business"/></div>
        <div class="form-field full"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@yourbusiness.com"/></div>
        <div class="form-field full"><label for="serviceArea">City or service area *</label><input id="serviceArea" name="serviceArea" autocomplete="address-level2" required maxlength="200" placeholder="Where do you serve your customers?"/></div>
        <div class="form-field full"><label for="planInterest">Have a plan in mind? <span>Optional</span></label><select id="planInterest" name="planInterest">{planInterestOptions.map(option=><option value={option}>{option}</option>)}</select></div>
        <div class="form-field full"><label for="message">What would make the biggest difference? <span>Optional</span></label><textarea id="message" name="message" rows="3" maxlength="5000" placeholder="A new website, better local visibility, or help getting started…"></textarea></div>
      </div>
      <details class="form-optional" data-optional-details><summary>Add a website, phone, or other details</summary><div class="form-grid">
        <div class="form-field full"><label for="websiteUrl">Current website <span>Optional</span></label><input id="websiteUrl" name="websiteUrl" type="text" inputmode="url" autocomplete="url" maxlength="500" placeholder="yourbusiness.com"/></div>
        <div class="form-field"><label for="phone">Phone <span>Optional</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/></div>
        <div class="form-field"><label for="industry">Business type <span>Optional</span></label><input id="industry" name="industry" maxlength="150" placeholder="e.g. Landscaping"/></div>
        <div class="form-field full"><label for="googleAdsInterest">Interested in Google Ads?</label><select id="googleAdsInterest" name="googleAdsInterest"><option value="Not sure yet">Not sure yet</option><option value="Yes">Yes</option><option value="No">No</option></select></div>
      </div></details>
      <div class="actions"><Button type="submit" size="lg">Get my recommendation <span aria-hidden="true">↗</span></Button></div>
      <p class="note">No obligation. We’ll review your details and reply by email.</p>
      <p class="note privacy-note">By submitting, you agree we may contact you about this inquiry. <a href="/privacy/">Privacy policy</a></p>
      <p class="form-status" role="alert" tabindex="-1" hidden data-form-status></p>
    </form>
  </div>
  <script>
    import {initContactForm} from '../scripts/contact';
    initContactForm();
  </script>
</MainLayout>
