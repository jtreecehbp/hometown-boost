---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import SceneWindow from '../components/SceneWindow.astro';
---
<MainLayout title="Thank You | Hometown Boost" description="We’ll review your inquiry and reply by email with a clear next step." robots="noindex,follow">
  <div class="container success-layout"><section class="success-panel"><span class="success-icon" aria-hidden="true">✓</span><span class="eyebrow" style="margin-top:28px">YOUR NEXT STEP IS UNDERWAY.</span><h1>Thanks for<br />getting in touch.</h1><p>We’ll review your business details and reply by email with a recommended next step. There’s no obligation to choose a plan.</p><div class="actions"><Button href="/pricing/">Review the plans <span aria-hidden="true">↗</span></Button><Button href="/" variant="outline">Back to Hometown Boost</Button></div></section><SceneWindow/></div>
</MainLayout>
