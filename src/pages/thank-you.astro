---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/icons/Icon.astro";

const title = "Thanks - Your Request Was Sent | Hometown Boost";
const description = "Thanks for contacting Hometown Boost. We will review your business, service area, and plan interest, then follow up with a clear next step.";
---

<MainLayout title={title} description={description} robots="noindex,follow">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow">Request Received</span>
        <h1>Thanks - your request was sent.</h1>
        <p>We will review your business, service area, and plan interest, then follow up with a clear next step.</p>
        <div class="hero__actions">
          <Button href="/" variant="secondary" size="lg">Return to homepage</Button>
          <Button href="/pricing/" variant="outline" size="lg">View pricing</Button>
        </div>
      </div>
      <div class="hero__media">
        <div class="card thank-you-card" aria-label="Request received">
          <span class="icon-circle"><Icon name="mail" /></span>
          <h2>Your details are on their way.</h2>
          <p>No pressure, no fake guarantees, just a clear recommendation for the next step.</p>
        </div>
      </div>
    </div>
  </section>

  <Section variant="light" title="While you wait" align="center">
    <div class="grid grid--3">
      <article class="card">
        <h3>Compare plans</h3>
        <p>Review page counts, support levels, minimum terms, and monthly pricing.</p>
        <Button href="/pricing/" variant="outline">View pricing</Button>
      </article>
      <article class="card">
        <h3>Read the checklist</h3>
        <p>See what a local business website should include before it goes live.</p>
        <Button href="/resources/local-business-website-essentials/" variant="outline">Open Checklist</Button>
      </article>
      <article class="card">
        <h3>Learn about ads</h3>
        <p>Understand when Google Ads makes sense and how the management fee works.</p>
        <Button href="/google-ads/" variant="outline">Google Ads</Button>
      </article>
    </div>
  </Section>
</MainLayout>
