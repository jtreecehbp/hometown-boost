---
import {getCollection} from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CTASection from '../components/ui/CTASection.astro';
import {pageMetadata} from '../data/metadata';
const resources=await getCollection('resources',({data})=>data.draft!==true);
---
<MainLayout {...pageMetadata.resources}>
  <PageHero eyebrow="A LITTLE KNOW-HOW FOR THE ROAD." title="Good advice for your next chapter." description="Straightforward guides to websites, local search, and getting your business noticed. Written for business owners with plenty else to do."/>
  <Section><div class="resource-grid">{resources.map(resource=><article class="resource-card"><span class="resource-card__category">{resource.data.category}</span><h2>{resource.data.title}</h2><p>{resource.data.description}</p><a class="text-link" href={`/resources/${resource.id}/`}>Read the guide <span aria-hidden="true">↗</span></a></article>)}</div></Section>
  <CTASection title="Want someone to handle the doing?" description="We can put the website essentials in place, then keep them cared for."/>
</MainLayout>
