---
import {getCollection} from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CTASection from '../components/ui/CTASection.astro';
import {pageMetadata} from '../data/metadata';
const resources=await getCollection('resources',({data})=>data.draft!==true);
---
<MainLayout {...pageMetadata.resources}>
  <PageHero eyebrow="CLEAR ANSWERS FOR BUSINESS OWNERS" title="Know what to improve. And where to start." description="Short guides to websites, Google Business Profiles, and search ads. Understand your options and decide what your business needs next."/>
  <Section><div class="resource-grid">{resources.map(resource=><article class="resource-card"><span class="resource-card__category">{resource.data.category}</span><h2>{resource.data.title}</h2><p>{resource.data.description}</p><a class="text-link" href={`/resources/${resource.id}/`} aria-label={`Read the guide: ${resource.data.title}`}>Read the guide <span aria-hidden="true">↗</span></a></article>)}</div></Section>
  <CTASection title="Put a better website to work." description="Tell us about your business. We’ll help you choose a website plan and explain what’s included."/>
</MainLayout>
