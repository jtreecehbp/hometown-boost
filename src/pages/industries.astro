---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CTASection from '../components/ui/CTASection.astro';
import Icon from '../components/icons/Icon.astro';
import {industries} from '../data/industries';
import {pageMetadata} from '../data/metadata';
---
<MainLayout {...pageMetadata.industries}>
  <PageHero eyebrow="BUILT AROUND THE WORK YOU DO." title="Your next customer needs a reason to choose you." description="Show the services, work, and business details that matter to your customers. Then make the next step easy, whether it’s a call, a quote request, or a visit."/>
  <Section><div class="grid grid--4">{industries.map(industry=><article class="card industry-card"><span class="icon-circle"><Icon name={industry.icon}/></span><h3>{industry.name}</h3><p>{industry.painPoint}</p><p class="note" style="margin-top:18px">A starting point: {industry.suggestedPlan}</p><a class="text-link" href={`/contact/?industry=${encodeURIComponent(industry.name)}`}>Talk about your business <span aria-hidden="true">↗</span></a></article>)}</div></Section>
  <CTASection title="Don’t see your business here?" description="Tell us what you offer and how customers find you today. We’ll help you choose the website and support that fit your business." primaryCta={{label:'Tell us about your business',href:'/contact/'}}/>
</MainLayout>
