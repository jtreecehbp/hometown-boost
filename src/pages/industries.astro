---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import Button from "../components/ui/Button.astro";
import IndustryCard from "../components/ui/IndustryCard.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";
import CTASection from "../components/ui/CTASection.astro";
import Icon from "../components/icons/Icon.astro";
import { pageMetadata } from "../data/metadata";
import { industries } from "../data/industries";

const planRows = [
  ["Solo operator just getting online", "Lite"],
  ["Small shop or simple service business", "Starter"],
  ["Contractor wanting more calls", "Growth"],
  ["Competitive trade or multi-service company", "Leader"],
  ["Business ready to run search ads", "Growth or Leader + Google Ads"],
];

const recommendedSections = [
  { industry: "Plumbers", sections: ["Emergency plumbing", "Drain cleaning", "Water heater service", "Service area", "Reviews", "Click-to-call CTA", "Request service form"] },
  { industry: "HVAC Companies", sections: ["AC repair", "Heating repair", "Installation/replacement", "Maintenance plans", "Service area", "Financing, if available", "Reviews"] },
  { industry: "Roofers", sections: ["Roof repair", "Roof replacement", "Storm damage", "Project photos", "Service area", "Reviews", "Request a quote"] },
  { industry: "Landscapers / Lawn Care", sections: ["Lawn care packages", "Seasonal services", "Landscaping projects", "Before/after photos", "Service area", "Quote request"] },
  { industry: "Towing", sections: ["Emergency towing", "Roadside assistance", "Service area", "Availability details, if true", "Tap-to-call button"] },
];

const getIndustryContactHref = (industry: string) => `/contact/?industry=${encodeURIComponent(industry)}`;
---

<MainLayout title={pageMetadata.industries.title} description={pageMetadata.industries.description}>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow">Industries</span>
        <h1>Websites built for the trades, shops, and service businesses that keep hometowns moving.</h1>
        <p>Whether you fix pipes, cut lawns, repair trucks, wire homes, or run a local shop, Hometown Boost helps your business look professional online.</p>
        <div class="hero__actions">
          <Button href="/contact/" variant="secondary" size="lg">Check My Fit</Button>
          <Button href="/pricing/" size="lg">Compare Plans</Button>
        </div>
        <ul class="hero__bullets">
          <li><span class="icon-circle"><Icon name="dollar" /></span>No setup fees</li>
          <li><span class="icon-circle"><Icon name="cloud" /></span>Hosting included</li>
          <li><span class="icon-circle"><Icon name="search" /></span>Local SEO foundation</li>
        </ul>
      </div>
      <div class="hero__media">
        <img src="/images/hometown-boost/hero-hometown-business-growth.svg" alt="Small-town businesses with website and service truck illustration." width="900" height="600" />
      </div>
    </div>
  </section>

  <Section title="Built for the industries that keep hometowns running." align="center">
    <div class="grid grid--4">
      {industries.map((industry) => (
        <IndustryCard
          {...industry}
          ctaHref={getIndustryContactHref(industry.name)}
          ctaLabel={`Get a ${industry.name} plan`}
        />
      ))}
    </div>
  </Section>

  <Section variant="light" title="Different businesses. Same basic need: be easy to find, trust, and contact." align="center">
    <div class="grid grid--3">
      <FeatureCard title="Emergency calls" description="Make urgent contact options easy to find on mobile." icon="phone" />
      <FeatureCard title="Quote requests" description="Give customers a simple path to request work." icon="clipboard" />
      <FeatureCard title="Service-area clarity" description="Show where you work and who you serve." icon="map-pin" />
      <FeatureCard title="Trust and reviews" description="Use real reviews, photos, and trust details when provided." icon="star" />
      <FeatureCard title="Mobile-friendly pages" description="Help phone users read, tap, and call quickly." icon="browser" />
      <FeatureCard title="Google visibility" description="Support local search with a stronger foundation." icon="search" />
    </div>
  </Section>

  <Section title="Recommended website sections by industry." description="These examples show the kinds of sections local service websites often need. Hometown Boost only includes claims like 24/7 service, licensing, insurance, family ownership, awards, or years in business when those details are true and provided by the business.">
    <div class="grid grid--5">
      {recommendedSections.map(({ industry, sections }) => (
        <article class="card">
          <h3>{industry}</h3>
          <ul class="check-list" style="margin-top: 0.9rem;">
            {sections.map((section) => <li>{section}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <Section title="Best-fit plan recommendations." align="center">
    <div class="table-wrap">
      <table>
        <caption>Best-fit plan recommendations by business type</caption>
        <thead>
          <tr>
            <th scope="col">Business Type</th>
            <th scope="col">Suggested Plan</th>
          </tr>
        </thead>
        <tbody>
          {planRows.map(([type, plan]) => (
            <tr>
              <td>{type}</td>
              <td><strong>{plan}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section variant="cream" title="Why local businesses choose us." align="center">
    <div class="grid grid--3">
      <FeatureCard title="No setup fees" description="Start without a large upfront website bill." icon="dollar" />
      <FeatureCard title="Simple monthly pricing" description="Clear plans that can grow with your needs." icon="calendar" />
      <FeatureCard title="Practical support" description="Plainspoken help for business owners who are busy." icon="phone" />
      <FeatureCard title="Built for local service businesses" description="Copy, structure, and pages built around real local customers." icon="storefront" />
      <FeatureCard title="Hosting and maintenance included" description="The technical care is part of the plan." icon="cloud" />
      <FeatureCard title="Upgrade path as you grow" description="Move into more support when your business needs it." icon="chart" />
    </div>
  </Section>

  <CTASection
    title="Find the plan that fits your business."
    primaryCta={{ label: "Check My Fit", href: "/contact/", variant: "secondary" }}
    secondaryCta={{ label: "Compare Plans", href: "/pricing/" }}
  />
</MainLayout>
