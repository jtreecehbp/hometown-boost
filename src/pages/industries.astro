---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CTASection from '../components/ui/CTASection.astro';
import Icon from '../components/icons/Icon.astro';
import {industries} from '../data/industries';
import {pageMetadata} from '../data/metadata';
---
<MainLayout {...pageMetadata.industries}>
  <PageHero eyebrow="THE BUSINESSES THAT MAKE A HOMETOWN." title="You keep your town going. Let’s keep your business growing." description="From the first service call to the last customer through the door, your website should make it easier for people to choose you."/>
  <Section><div class="grid grid--4">{industries.map(industry=><article class="card industry-card"><span class="icon-circle"><Icon name={industry.icon}/></span><h3>{industry.name}</h3><p>{industry.painPoint}</p><p class="note" style="margin-top:18px">A starting point: {industry.suggestedPlan}</p><a class="text-link" href={`/contact/?industry=${encodeURIComponent(industry.name)}`}>Talk about your business <span aria-hidden="true">↗</span></a></article>)}</div></Section>
  <CTASection title="Don’t see your business here?" description="If you serve your neighbors, we’d like to hear what you do. Let’s see where we can help." primaryCta={{label:'Tell us what you do',href:'/contact/'}}/>
</MainLayout>
