---
import Button from "../ui/Button.astro";
import { footerLinks } from "../../data/navigation";
import { pricingPlans } from "../../data/pricingPlans";
import { siteConfig } from "../../data/siteConfig";

const startingPriceMonthly = pricingPlans[0].priceLabel.replace("/mo", "/month");
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <a href="/" class="brand" aria-label="Hometown Boost home">
          <span class="brand__mark" aria-hidden="true">
            <img src="/images/hometown-boost/hometown-boost-logo.webp" alt="" width="84" height="84" loading="lazy" decoding="async" />
          </span>
          <span class="brand__name">
            <span>Hometown</span>
            <span>Boost</span>
          </span>
        </a>
        <p style="margin-top: 1rem;">
          Hometown Boost helps local businesses look better online, get found more easily, and grow with simple monthly website and marketing plans.
        </p>
      </div>
      <div>
        <h3>Quick Links</h3>
        <ul>
          {footerLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Services</h3>
        <ul>
          <li><a href="/services/">Website Plans</a></li>
          <li><a href="/services/">Local SEO Foundation</a></li>
          <li><a href="/google-ads/">Google Ads Management</a></li>
          <li><a href="/resources/">Resources</a></li>
        </ul>
      </div>
      <div>
        <h3>Start Here</h3>
        <p>No setup fees. Plans start at {startingPriceMonthly}. Hosting and maintenance included.</p>
        <div class="actions">
          <Button href="/pricing/" variant="primary" size="sm">View Plans</Button>
          <Button href="/contact/" variant="secondary" size="sm">Check My Fit</Button>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</span>
      <span>
        <a href="/privacy/">Privacy</a> &nbsp; <a href="/terms/">Terms</a> &nbsp; <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </span>
    </div>
  </div>
</footer>
