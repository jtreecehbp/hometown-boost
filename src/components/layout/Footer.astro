---
import Brand from './Brand.astro';
import { siteConfig } from '../../data/siteConfig';
const groups = [
  {title:'Get growing',links:[['Website plans','/pricing/'],['What we do','/services/'],['How it works','/how-it-works/'],['Google Ads','/google-ads/']]},
  {title:'Get to know us',links:[['About Hometown Boost','/about/'],['Who we help','/industries/'],['Helpful resources','/resources/'],['Questions & answers','/faq/']]}
];
---
<footer class="footer"><div class="container">
  <div class="footer__top">
    <div class="footer__brand"><Brand /><p>Good at what you do?<br />Let’s make sure your town knows it.</p><a class="text-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <span aria-hidden="true">↗</span></a></div>
    {groups.map(group => <div><h3>{group.title}</h3><ul>{group.links.map(([label,href]) => <li><a href={href}>{label}</a></li>)}</ul></div>)}
    <div class="footer__hello"><span class="status-dot"></span><h3>Your next chapter<br />starts here.</h3><a class="text-link" href="/contact/">Let’s talk about your business <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="footer__bottom"><p>© {new Date().getFullYear()} Hometown Boost</p><p>Made for the businesses that make a hometown.</p><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div></div>
</div></footer>
