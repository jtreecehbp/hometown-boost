---
import Button from '../ui/Button.astro';
import Brand from './Brand.astro';
const links = [{label:'What we do',href:'/services/'},{label:'How it works',href:'/how-it-works/'},{label:'Our plans',href:'/pricing/'},{label:'About us',href:'/about/'}];
---
<header class="header"><div class="container header__inner">
  <Brand />
  <button class="menu-toggle" type="button" aria-label="Open main menu" aria-expanded="false" aria-controls="main-navigation" data-menu-button><span></span><span></span></button>
  <nav class="nav" id="main-navigation" aria-label="Main navigation" data-main-menu>
    {links.map(link => <a class="nav__link" href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>)}
    <a class="nav__mobile-cta" href="/contact/">Find my plan <span aria-hidden="true">↗</span></a>
  </nav>
  <Button class="header__cta" href="/contact/" size="sm">Let’s talk <span aria-hidden="true">↗</span></Button>
</div></header>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-main-menu]');
  if (button && menu) {
    const setOpen = (open: boolean) => { button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', open ? 'Close main menu' : 'Open main menu'); menu.classList.toggle('is-open', open); };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', event => { if ((event.target as Element).closest('a')) setOpen(false); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') { setOpen(false); button.focus(); } });
    document.addEventListener('click', event => { if (!(event.target as Element).closest('.header')) setOpen(false); });
    matchMedia('(min-width: 901px)').addEventListener('change', event => { if (event.matches) setOpen(false); });
  }
</script>
