---
import { siteConfig } from "../../data/siteConfig";
import displayFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

type Schema = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: "website" | "article";
  robots?: string;
  schema?: Schema | Schema[];
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, siteConfig.url).toString(),
  image = "/images/hometown-boost/social-preview.png",
  imageAlt = "Hometown Boost websites and local marketing for hometown businesses.",
  imageWidth = 1200,
  imageHeight = 630,
  ogType = "website",
  robots,
  schema,
} = Astro.props;

const imageUrl = new URL(image, siteConfig.url).toString();
const schemaItems: Schema[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    email: siteConfig.email,
    description: siteConfig.description,
    logo: new URL("/images/hometown-boost/hb-rocket-mark.webp", siteConfig.url).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    description: siteConfig.description,
  },
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>document.documentElement.dataset.enhanced = 'true';</script>
<meta name="theme-color" content="#10253f" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:url" content={canonical} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaItems)}></script>
