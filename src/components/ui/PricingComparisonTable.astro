---
import { pricingPlans } from "../../data/pricingPlans";

const detailRows = [
  ["Monthly price", ...pricingPlans.map((plan) => plan.priceLabel)],
  ["Setup fee", ...pricingPlans.map((plan) => plan.setupFeeLabel)],
  ["Minimum term", ...pricingPlans.map((plan) => plan.minimumTerm)],
  ["Minimum commitment", ...pricingPlans.map((plan) => plan.minimumCommitment)],
  ["Website size", ...pricingPlans.map((plan) => plan.websiteSize)],
];
const features = [
  { label: "Hosting, security, and maintenance", foundation: "Included", connect: "Included", marketing: "Included" },
  { label: "Contact form and click-to-call", foundation: "Included", connect: "Included", marketing: "Included" },
  { label: "Local SEO setup", foundation: "Included", connect: "Included", marketing: "Included" },
  { label: "Ongoing Google Business Profile management", foundation: "1 profile", connect: "1 profile", marketing: "1 profile" },
  { label: "Google Business Profile posts", foundation: "2/month", connect: "2/month", marketing: "2/month" },
  { label: "Review-request email + one reminder, link, and QR setup", foundation: "Included", connect: "Included", marketing: "Included" },
  { label: "Website review showcase", foundation: "Included", connect: "Included", marketing: "Included" },
  { label: "Review monitoring and response support", foundation: "Included", connect: "Included", marketing: "Included" },
  { label: "Website text and photo updates", foundation: "One monthly batch", connect: "One monthly batch", marketing: "Monthly updates + landing-page improvements" },
  { label: "Website and Google performance report", foundation: "Monthly", connect: "Monthly", marketing: "Monthly" },
  { label: "Supported CRM or job-software connections", foundation: "Not included", connect: "Included in agreed scope", marketing: "Included in agreed scope" },
  { label: "Booking and calendar integration", foundation: "Not included", connect: "Included in agreed scope", marketing: "Included in agreed scope" },
  { label: "Automated inquiry follow-up", foundation: "Not included", connect: "Included in agreed scope", marketing: "Included in agreed scope" },
  { label: "Integration monitoring and support", foundation: "Not included", connect: "Included", marketing: "Included in agreed scope" },
  { label: "Ongoing SEO and service-area pages", foundation: "Quoted separately", connect: "Quoted separately", marketing: "Monthly priority work" },
  { label: "Call/form conversion tracking", foundation: "Basic inquiry reporting", connect: "Inquiry-source reporting", marketing: "Campaign conversion tracking where supported" },
  { label: "Ad spend", foundation: "Separate if using ads", connect: "Separate if using ads", marketing: "Separate; paid directly to Google" },
  { label: "Google Ads management", foundation: "Optional if ready", connect: "Optional if ready", marketing: "1 Google Search campaign included" },
];
const rows = [...detailRows, ...features.map((feature) => [feature.label, ...pricingPlans.map((plan) => feature[plan.id])])];
---

<p class="comparison-help">Scroll across to compare plans, and down for every feature. Plan names and feature labels stay in view.</p>
<div class="table-wrap plan-comparison" tabindex="0" role="region" aria-label="Website plan comparison, scroll across for plans and down for features">
  <table>
    <caption>Detailed website plan comparison</caption>
    <thead>
      <tr>
        <th scope="col">Feature</th>
        {pricingPlans.map((plan) => (
          <th scope="col" class={plan.featured ? "table-highlight" : undefined}>{plan.shortName}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row[0]}</th>
          {row.slice(1).map((cell, index) => (
            <td class={pricingPlans[index].featured ? "table-highlight" : undefined}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .comparison-help { margin-bottom: 14px; max-width: 620px; font-size: .875rem; }
  .plan-comparison { max-height: min(740px, calc(100svh - var(--header-height) - 64px)); overflow: auto; overscroll-behavior: contain; }
  .plan-comparison table { border-collapse: separate; border-spacing: 0; }
  .plan-comparison thead th { position: sticky; top: 0; z-index: 2; background: #edf5fb; box-shadow: 0 1px 0 var(--line); }
  .plan-comparison th:first-child { position: sticky; left: 0; z-index: 1; min-width: 155px; background: #fff; box-shadow: 1px 0 0 var(--line); }
  .plan-comparison thead th:first-child { z-index: 3; background: #edf5fb; }
</style>
