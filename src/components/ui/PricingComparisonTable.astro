---
import { pricingPlans } from "../../data/pricingPlans";

const [lite, starter, growth, leader] = pricingPlans;
const rows = [
  ["Monthly price", ...pricingPlans.map((plan) => plan.priceLabel)],
  ["Setup fee", ...pricingPlans.map((plan) => plan.setupFeeLabel)],
  ["Minimum term", ...pricingPlans.map((plan) => plan.minimumTerm)],
  ["Minimum commitment", ...pricingPlans.map((plan) => plan.minimumCommitment)],
  ["Website size", lite.websiteSize, starter.websiteSize, growth.websiteSize, leader.websiteSize],
  ["Hosting included", "Yes", "Yes", "Yes", "Yes"],
  ["SSL/security", "Yes", "Yes", "Yes", "Yes"],
  ["Mobile-friendly design", "Yes", "Yes", "Yes", "Yes"],
  ["Contact form", "Yes", "Yes", "Yes", "Yes"],
  ["Click-to-call buttons", "Yes", "Yes", "Yes", "Yes"],
  ["Basic SEO setup", "Yes", "Yes", "Yes", "Yes"],
  ["Google Business Profile checkup", "No or light business-info review", "Yes", "Yes", "Yes"],
  ["Google Business Profile optimization", "No", "No", "Yes", "Yes"],
  ["Review link / QR setup", "No", "Optional add-on", "Yes", "Yes"],
  ["Monthly Google Business Profile post", "No", "No", "1/month", "1/month"],
  ["Updates", "Quarterly small update", "Small monthly edit", "Monthly edits", "Priority monthly updates"],
  ["Reporting", "No", "Quarterly", "Monthly", "Monthly"],
  ["Service-area pages", "No", "No", "Add-on", "Included/limited"],
  ["Ongoing SEO improvements", "No", "No", "Foundation only", "Yes"],
  ["Citation cleanup starter", "No", "No", "Add-on", "Yes"],
  ["Quarterly strategy call", "No", "No", "No", "Yes"],
  ["Google Ads management", "Not included", "Optional if qualified", "Optional add-on", "Optional add-on"],
];
---

<p class="comparison-help">Scroll across for all four plans, and down for every feature. Plan names and feature labels stay in view.</p>
<div class="table-wrap plan-comparison" tabindex="0" role="region" aria-label="Website plan comparison, scroll across for plans and down for features">
  <table>
    <caption>Detailed website plan comparison</caption>
    <thead>
      <tr>
        <th scope="col">Feature</th>
        {pricingPlans.map((plan) => (
          <th scope="col" class={plan.id === "growth" ? "table-highlight" : undefined}>{plan.shortName}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row[0]}</th>
          {row.slice(1).map((cell, index) => (
            <td class={pricingPlans[index].id === "growth" ? "table-highlight" : undefined}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .comparison-help { margin-bottom: 14px; max-width: 620px; font-size: .875rem; }
  .plan-comparison { max-height: min(740px, calc(100svh - var(--header-height) - 64px)); overflow: auto; overscroll-behavior: contain; }
  .plan-comparison table { border-collapse: separate; border-spacing: 0; }
  .plan-comparison thead th { position: sticky; top: 0; z-index: 2; background: #edf5fb; box-shadow: 0 1px 0 var(--line); }
  .plan-comparison th:first-child { position: sticky; left: 0; z-index: 1; min-width: 155px; background: #fff; box-shadow: 1px 0 0 var(--line); }
  .plan-comparison thead th:first-child { z-index: 3; background: #edf5fb; }
</style>
