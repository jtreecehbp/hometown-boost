---
import Icon from "../icons/Icon.astro";

interface Props {
  title: string;
  description: string;
  icon?: string;
  tone?: "blue" | "orange" | "green";
}

const { title, description, icon = "star", tone = "blue" } = Astro.props;
const iconClass = tone === "orange" ? "icon-circle icon-orange" : tone === "green" ? "icon-circle icon-green" : "icon-circle";
---

<article class="card feature-card">
  <span class={iconClass}><Icon name={icon} /></span>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
