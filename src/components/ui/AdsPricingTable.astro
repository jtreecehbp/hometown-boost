---
import { googleAdsPricing } from "../../data/pricingPlans";
---

<div class="table-wrap ads-comparison" tabindex="0" role="region" aria-label="Google Ads pricing examples">
  <table>
    <caption>Google Ads pricing examples</caption>
    <thead>
      <tr>
        <th scope="col">Monthly ad budget</th>
        <th scope="col">Our fee</th>
        <th scope="col">Monthly total</th>
      </tr>
    </thead>
    <tbody>
      {googleAdsPricing.examples.map((example) => (
        <tr>
          <td>{example.adSpend}</td>
          <td>{example.managementFee}</td>
          <td>{example.totalInvestment}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .ads-comparison table { min-width: 0; table-layout: fixed; }
  @media (max-width: 680px) {
    .ads-comparison th, .ads-comparison td { padding: 14px 10px; }
    .ads-comparison th { font-size: 12px; }
  }
</style>
