---
import Button from './Button.astro';
import type { PricingPlan } from '../../data/pricingPlans';
interface Props { plan: PricingPlan; featureLimit?: number; showNotIncluded?: boolean; }
const {plan,featureLimit,showNotIncluded=false} = Astro.props;
const compactFeatures = {
  foundation: [plan.websiteSize, 'Ongoing Google profile management', 'Review requests & response support', 'Monthly updates & reporting', 'Hosting, security & maintenance'],
  connect: ['Everything in Foundation', 'CRM & business-tool connections', 'Online booking & calendar sync', 'Automatic inquiry follow-up', 'Ongoing integration management'],
  leader: [plan.websiteSize, 'Managed Google profile & reviews', 'Service-area SEO pages', 'Ongoing SEO improvements', 'Priority updates & strategy'],
};
const features = typeof featureLimit === 'number' ? compactFeatures[plan.id].slice(0,featureLimit) : plan.highlights;
---
<article class:list={['pricing-card',{'pricing-card--featured':plan.featured}]}>
  <div class="pricing-card__topline"><h3>{plan.shortName}</h3>{plan.featured && <span class="pill">{plan.badge || "Recommended"}</span>}</div>
  <p class="pricing-card__for">{plan.bestFor}</p>
  <div class="pricing-card__price">${plan.price}<span>/ month</span></div>
  <p class="pricing-card__terms">$0 setup · {plan.minimumMonths}-month minimum</p>
  <Button href={plan.ctaHref} variant={plan.featured ? 'primary' : 'outline'}>{plan.ctaLabel} <span aria-hidden="true">↗</span></Button>
  <ul class="check-list">{features.map(feature => <li>{feature}</li>)}</ul>
  {showNotIncluded && <details class="plan-exclusions"><summary>What’s outside this plan?</summary><ul>{plan.notIncluded.map(feature => <li>{feature}</li>)}</ul></details>}
  <p class="pricing-card__commitment">{plan.minimumCommitment} total minimum commitment</p>
</article>
