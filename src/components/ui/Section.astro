---
import Container from "./Container.astro";

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  variant?: "default" | "light" | "cream" | "navy";
  align?: "left" | "center";
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  variant = "default",
  align = "left",
} = Astro.props;
const className = Astro.props.class ?? "";
const sectionClass = variant === "default" ? "section" : `section section--${variant}`;
---

<section id={id} class={`${sectionClass} ${className}`}>
  <Container>
    {(eyebrow || title || description) && (
      <div class={`section__header ${align === "center" ? "center" : ""}`}>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {title && <h2 style="margin-top: 0.8rem;">{title}</h2>}
        {description && <p style="margin-top: 0.8rem;">{description}</p>}
      </div>
    )}
    <slot />
  </Container>
</section>
