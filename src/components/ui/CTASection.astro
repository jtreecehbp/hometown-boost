---
import Button from "./Button.astro";

interface Cta {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
}

const { eyebrow, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta-band">
      <div class="cta-band__inner">
        <div>
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h2 style="margin-top: 0.8rem;">{title}</h2>
          {description && <p style="margin-top: 0.65rem;">{description}</p>}
        </div>
        <div class="actions" style="margin-top: 0;">
          <Button href={primaryCta.href} variant={primaryCta.variant ?? "secondary"}>{primaryCta.label}</Button>
          {secondaryCta && <Button href={secondaryCta.href} variant={secondaryCta.variant ?? "outline"}>{secondaryCta.label}</Button>}
        </div>
      </div>
    </div>
  </div>
</section>
