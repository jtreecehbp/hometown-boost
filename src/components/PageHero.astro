---
import SceneWindow from './SceneWindow.astro';
interface Props {eyebrow:string;title:string;description?:string;center?:boolean;}
const {eyebrow,title,description,center=false}=Astro.props;
---
<section class:list={['page-hero',{'page-hero--center':center}]}><div class="container page-hero__layout"><div class="page-hero__inner"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1>{description&&<p>{description}</p>}<slot/></div><SceneWindow/></div></section>
