---
import Icon from "../icons/Icon.astro";

const handledItems = [
  {
    title: "Website Design",
    body: "A professional site built around your services and goals.",
    icon: "browser",
  },
  {
    title: "Hosting & Maintenance",
    body: "We keep the site online, secure, and up to date.",
    icon: "cloud",
  },
  {
    title: "Mobile Optimization",
    body: "Fast, easy browsing for customers on their phones.",
    icon: "phone",
  },
  {
    title: "Local SEO Foundation",
    body: "Page structure and content built for local visibility.",
    icon: "search",
  },
  {
    title: "Contact Forms & Call Buttons",
    body: "Simple ways for customers to reach you quickly.",
    icon: "mail",
  },
  {
    title: "Ongoing Edits & Support",
    body: "Need a change? We help keep things current.",
    icon: "wrench",
  },
  {
    title: "Optional Google Ads",
    body: "Add paid search support when you're ready to grow faster.",
    icon: "megaphone",
  },
];
---

<section class="infographic-section handled-for-you-infographic" aria-labelledby="handled-for-you-infographic-title">
  <div class="infographic-wrap">
    <div class="infographic-heading">
      <p class="eyebrow">Done for you</p>
      <h2 id="handled-for-you-infographic-title">What Hometown Boost Handles For You</h2>
      <p>So you can stay focused on running the business</p>
    </div>

    <div class="infographic-grid handled-grid">
      {handledItems.map((item) => (
        <article class="infographic-card">
          <span class="infographic-icon" aria-hidden="true"><Icon name={item.icon} /></span>
          <div class="infographic-card__body">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="infographic-footer-strip">
      <strong>Simple</strong>
      <span>Professional</span>
      <span>Done-for-you</span>
    </div>
  </div>
</section>
