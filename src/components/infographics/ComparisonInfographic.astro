---
const columns = [
  {
    title: "Hometown Boost",
    tone: "best",
    points: [
      "No setup fees",
      "Done-for-you website",
      "Built for local businesses",
      "Hosting and maintenance included",
      "Simple monthly plans",
    ],
  },
  {
    title: "DIY Website Builders",
    tone: "neutral",
    points: [
      "Lower software cost",
      "Business owner does the work",
      "Support can be limited",
      "Easy to get stuck",
      "Local SEO takes extra effort",
    ],
  },
  {
    title: "Traditional Agencies",
    tone: "neutral",
    points: [
      "Professional help",
      "Often higher upfront cost",
      "Custom pricing",
      "Can be more than small businesses need",
      "More meetings and process",
    ],
  },
];
---

<div class="infographic comparison" aria-label="Hometown Boost compared with DIY builders and traditional agencies">
  {columns.map((column) => (
    <article class={`comparison__column ${column.tone === "best" ? "comparison__column--best" : ""}`}>
      <h3>{column.title}</h3>
      <ul class="check-list">
        {column.points.map((point) => <li>{point}</li>)}
      </ul>
    </article>
  ))}
</div>

<style>
  .comparison {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .comparison__column {
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    padding: 1rem;
  }

  .comparison__column--best {
    border-color: var(--hb-orange);
    background: var(--hb-cream);
  }

  .comparison__column h3 {
    margin-bottom: 0.8rem;
  }

  @media (max-width: 820px) {
    .comparison {
      grid-template-columns: 1fr;
    }
  }
</style>
