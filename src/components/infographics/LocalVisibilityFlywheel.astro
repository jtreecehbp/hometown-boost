---
import Icon from "../icons/Icon.astro";

const steps = [
  { title: "Professional Website", icon: "browser" },
  { title: "Google Business Profile", icon: "storefront" },
  { title: "Reviews", icon: "star" },
  { title: "Local SEO", icon: "search" },
  { title: "Google Ads", icon: "megaphone" },
  { title: "Reports and Updates", icon: "chart" },
];
---

<div class="infographic visibility" aria-label="Local visibility flywheel">
  <p class="visibility__message">
    A good website is the foundation. Local visibility grows when your website, Google profile, reviews, and lead tools work together.
  </p>
  <div class="visibility__steps">
    {steps.map((step) => (
      <article class="visibility__step">
        <span class="icon-circle"><Icon name={step.icon} /></span>
        <h3>{step.title}</h3>
      </article>
    ))}
  </div>
</div>

<style>
  .visibility__message {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .visibility__steps {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .visibility__step {
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    min-height: 150px;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    padding: 1rem 0.7rem;
    text-align: center;
  }

  @media (max-width: 980px) {
    .visibility__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .visibility__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
