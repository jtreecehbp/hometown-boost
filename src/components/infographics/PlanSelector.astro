---
import Icon from "../icons/Icon.astro";
import { pricingPlans } from "../../data/pricingPlans";

const planNeeds = {
  lite: { need: "Need the lowest-cost web presence?", icon: "storefront" },
  starter: { need: "Need a simple professional site?", icon: "browser" },
  growth: { need: "Want more calls and local visibility?", icon: "chart" },
  leader: { need: "Want ongoing growth support?", icon: "rocket" },
};
---

<div class="infographic plan-selector" aria-label="Which Hometown Boost plan fits you">
  {pricingPlans.map((plan) => (
    <a class={`plan-selector__item ${plan.featured ? "plan-selector__item--growth" : ""}`} href={plan.ctaHref}>
      <span class="icon-circle"><Icon name={planNeeds[plan.id].icon} /></span>
      <span>{planNeeds[plan.id].need}</span>
      <strong>{plan.shortName}</strong>
    </a>
  ))}
</div>

<style>
  .plan-selector {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .plan-selector__item {
    display: grid;
    gap: 0.7rem;
    min-height: 190px;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    background: var(--hb-white);
    padding: 1rem;
  }

  .plan-selector__item strong {
    color: var(--hb-blue-dark);
    font-size: 1.4rem;
  }

  .plan-selector__item--growth {
    border-color: var(--hb-orange);
    background: var(--hb-cream);
  }

  .plan-selector__item--growth strong {
    color: var(--hb-orange-dark);
  }

  @media (max-width: 820px) {
    .plan-selector {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .plan-selector {
      grid-template-columns: 1fr;
    }
  }
</style>
