---
import Icon from "../icons/Icon.astro";
import { pricingPlans } from "../../data/pricingPlans";

const planNeeds = {
  foundation: { need: "Have your website, Google profile, and reviews handled.", icon: "storefront" },
  connect: { need: "Connect your business tools and automate customer follow-up.", icon: "chart" },
  marketing: { need: "Manage a Google Search campaign and improve local visibility.", icon: "rocket" },
};
---

<div class="infographic plan-selector" aria-label="Which Hometown Boost plan fits you">
  {pricingPlans.map((plan) => (
    <a class={`plan-selector__item ${plan.featured ? "plan-selector__item--featured" : ""}`} href={plan.ctaHref}>
      <span class="icon-circle"><Icon name={planNeeds[plan.id].icon} /></span>
      <span>{planNeeds[plan.id].need}</span>
      <strong>{plan.shortName}</strong>
    </a>
  ))}
</div>

<style>
  .plan-selector {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.85rem;
  }

  .plan-selector__item {
    display: grid;
    gap: 0.7rem;
    min-height: 190px;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    background: var(--hb-white);
    padding: 1rem;
  }

  .plan-selector__item strong {
    color: var(--hb-blue-dark);
    font-size: 1.4rem;
  }

  .plan-selector__item--featured {
    border-color: var(--hb-orange);
    background: var(--hb-cream);
  }

  .plan-selector__item--featured strong {
    color: var(--hb-orange-dark);
  }

  @media (max-width: 820px) {
    .plan-selector {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .plan-selector {
      grid-template-columns: 1fr;
    }
  }
</style>
