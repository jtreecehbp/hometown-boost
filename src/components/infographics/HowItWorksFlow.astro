---
import Icon from "../icons/Icon.astro";

const steps = [
  {
    title: "Choose Your Plan",
    copy: "Pick the monthly plan that fits your business.",
    icon: "clipboard",
  },
  {
    title: "We Build Your Site",
    copy: "We create a clean, mobile-friendly website with the essentials handled.",
    icon: "browser",
  },
  {
    title: "Launch and Grow",
    copy: "Your site goes live, stays maintained, and can grow with SEO or ads.",
    icon: "rocket",
  },
];
---

<div class="infographic flow-graphic" aria-label="How Hometown Boost works">
  <div class="flow">
    {steps.map((step, index) => (
      <article class="card flow__step">
        <span class="flow__number">{index + 1}</span>
        <span class="icon-circle" style="margin-top: 1rem;"><Icon name={step.icon} /></span>
        <h3 style="margin-top: 1rem;">{step.title}</h3>
        <p>{step.copy}</p>
      </article>
    ))}
  </div>
</div>

<style>
  .flow-graphic {
    position: relative;
  }

  @media (min-width: 981px) {
    .flow-graphic::before {
      position: absolute;
      left: 16%;
      right: 16%;
      top: 72px;
      height: 3px;
      background: linear-gradient(90deg, var(--hb-blue), var(--hb-orange));
      content: "";
      opacity: 0.28;
    }
  }
</style>
