---
import Icon from "../icons/Icon.astro";

const websiteJobs = [
  {
    title: "Build Trust Fast",
    body: "Clear services, real photos, and strong reviews.",
    icon: "shield",
  },
  {
    title: "Make Contact Easy",
    body: "Tap-to-call buttons, quote forms, and simple navigation.",
    icon: "phone",
  },
  {
    title: "Show Where You Work",
    body: "Service areas, local relevance, and easy-to-find info.",
    icon: "map-pin",
  },
  {
    title: "Turn Visits Into Leads",
    body: "Fast mobile experience, strong calls to action, and pages built to convert.",
    icon: "chart",
  },
];
---

<section class="infographic-section website-jobs-infographic" aria-labelledby="website-jobs-infographic-title">
  <div class="infographic-wrap">
    <div class="infographic-heading">
      <p class="eyebrow">Website foundation</p>
      <h2 id="website-jobs-infographic-title">What a Local Business Website Should Actually Do</h2>
      <p>A good website should work like a salesperson for your business</p>
    </div>

    <div class="website-jobs-layout">
      <div class="website-mockup" aria-hidden="true">
        <div class="website-mockup__bar"></div>
        <div class="website-mockup__body">
          <span class="website-mockup__headline"></span>
          <span class="website-mockup__line"></span>
          <span class="website-mockup__line"></span>
          <span class="website-mockup__button"></span>
          <span class="website-mockup__photo"></span>
        </div>
      </div>

      <div class="infographic-grid">
        {websiteJobs.map((job) => (
          <article class="infographic-card">
            <span class="infographic-icon" aria-hidden="true"><Icon name={job.icon} /></span>
            <div class="infographic-card__body">
              <h3>{job.title}</h3>
              <p>{job.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="infographic-footer-strip">
      <strong>More trust</strong>
      <span>More calls</span>
      <span>More quote requests</span>
    </div>
  </div>
</section>
