---
import Icon from "../icons/Icon.astro";

const growthElements = [
  {
    title: "Website",
    body: "Professional, mobile-friendly, built to convert.",
    icon: "browser",
  },
  {
    title: "Google Business Profile",
    body: "Accurate information and stronger local presence.",
    icon: "storefront",
  },
  {
    title: "Reviews",
    body: "Build trust and improve response rates.",
    icon: "star",
  },
  {
    title: "Google Ads (Optional)",
    body: "Reach high-intent search traffic faster.",
    icon: "megaphone",
  },
];

const growthResults = [
  "More Calls",
  "More Quote Requests",
  "Better Local Visibility",
];

const growthCallouts = [
  "Consistent business info",
  "Clear service pages",
  "Strong calls to action",
  "Monthly improvement",
];
---

<section class="infographic-section infographic-section--light local-growth-system-infographic" aria-labelledby="local-growth-system-infographic-title">
  <div class="infographic-wrap">
    <div class="infographic-heading">
      <p class="eyebrow">Local growth system</p>
      <h2 id="local-growth-system-infographic-title">The Hometown Boost Local Growth System</h2>
      <p>How the pieces work together to create more visibility and more leads</p>
    </div>

    <div class="growth-system-layout">
      <div class="growth-elements">
        {growthElements.map((item) => (
          <article class="infographic-card">
            <span class="infographic-icon" aria-hidden="true"><Icon name={item.icon} /></span>
            <div class="infographic-card__body">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="results-box">
        <div>
          <strong>Results this system supports</strong>
          <p style="margin: 0.35rem 0 0; color: #ffffff;">Start with the foundation, then grow.</p>
        </div>
        <ul class="results-list">
          {growthResults.map((result) => <li>{result}</li>)}
        </ul>
      </div>

      <div class="supporting-callouts" aria-label="Supporting local growth details">
        {growthCallouts.map((callout) => <span>{callout}</span>)}
      </div>
    </div>
  </div>
</section>
