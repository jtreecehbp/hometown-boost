---
import Icon from "../icons/Icon.astro";

const items = [
  { title: "Hosting", copy: "Fast, reliable site hosting.", icon: "cloud" },
  { title: "SSL/security", copy: "Basic security and SSL included.", icon: "shield" },
  { title: "Maintenance", copy: "Core care handled for you.", icon: "wrench" },
  { title: "Lead Tools", copy: "Forms and click-to-call paths.", icon: "phone" },
  { title: "SEO Foundation", copy: "Search-friendly page basics.", icon: "search" },
  { title: "Updates", copy: "Plan-based updates and reports.", icon: "chart" },
];
---

<div class="infographic flywheel" aria-label="What you get every month">
  <div class="flywheel__center">
    <img src="/images/hometown-boost/hometown-boost-logo.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />
    <strong>Website + Google presence + trust + leads</strong>
  </div>
  <div class="flywheel__items">
    {items.map((item) => (
      <article class="flywheel__item">
        <span class="icon-circle"><Icon name={item.icon} /></span>
        <div>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .flywheel {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    align-items: center;
    gap: 1.2rem;
  }

  .flywheel__center {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    background: var(--hb-sky-2);
    padding: 1.2rem;
    text-align: center;
  }

  .flywheel__center img {
    width: 82px;
    height: 82px;
    border-radius: var(--hb-radius-md);
    object-fit: cover;
    object-position: center 23%;
    transform: scale(1.35);
  }

  .flywheel__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .flywheel__item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    padding: 0.85rem;
  }

  .flywheel__item p {
    margin: 0.25rem 0 0;
  }

  @media (max-width: 760px) {
    .flywheel,
    .flywheel__items {
      grid-template-columns: 1fr;
    }
  }
</style>
