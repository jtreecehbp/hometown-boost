---
import Icon from "../icons/Icon.astro";
import { googleAdsPricing } from "../../data/pricingPlans";
---

<div class="infographic ads-formula" aria-label="Google Ads pricing formula">
  <div class="ads-formula__piece">
    <span class="icon-circle"><Icon name="calendar" /></span>
    <strong>{googleAdsPricing.baseManagementFeeLabel}</strong>
    <span>Base management fee</span>
  </div>
  <span class="ads-formula__operator">+</span>
  <div class="ads-formula__piece">
    <span class="icon-circle icon-orange"><Icon name="chart" /></span>
    <strong>{googleAdsPricing.adSpendPercentageLabel}</strong>
    <span>Of monthly ad spend</span>
  </div>
  <span class="ads-formula__operator">=</span>
  <div class="ads-formula__piece ads-formula__piece--total">
    <span class="icon-circle icon-green"><Icon name="dollar" /></span>
    <strong>Management fee</strong>
    <span>Separate from Google ad spend</span>
  </div>
</div>

<style>
  .ads-formula {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1.2fr;
    align-items: center;
    gap: 0.8rem;
  }

  .ads-formula__piece {
    display: grid;
    min-height: 150px;
    justify-items: center;
    gap: 0.55rem;
    border: 1px solid var(--hb-border);
    border-radius: var(--hb-radius-md);
    padding: 1rem;
    text-align: center;
  }

  .ads-formula__piece strong {
    font-size: 1.45rem;
    line-height: 1.1;
  }

  .ads-formula__piece span:last-child {
    color: var(--hb-slate);
  }

  .ads-formula__piece--total {
    background: var(--hb-sky-2);
  }

  .ads-formula__operator {
    color: var(--hb-muted);
    font-size: 2rem;
    font-weight: 900;
  }

  @media (max-width: 820px) {
    .ads-formula {
      grid-template-columns: 1fr;
    }

    .ads-formula__operator {
      text-align: center;
    }
  }
</style>
