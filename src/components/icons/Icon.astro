---
interface Props {
  name?: string;
  size?: number;
  strokeWidth?: number;
}

const { name = "star", size = 24, strokeWidth = 2.2 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "wrench" && <><path d="M14.7 6.3a4 4 0 0 0-5 5L3 18v3h3l6.7-6.7a4 4 0 0 0 5-5l-2.8 2.8-3-3 2.8-2.8Z" /></>}
  {name === "hvac" && <><path d="M12 2v20" /><path d="m5 5 14 14" /><path d="m19 5-14 14" /><path d="M4 12h16" /></>}
  {name === "bolt" && <path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" />}
  {name === "roof" && <><path d="m3 11 9-7 9 7" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></>}
  {name === "leaf" && <><path d="M20 4c-8.5.4-13.5 4.5-14 12 5.8 1 10.9-1.6 14-12Z" /><path d="M6 16c3-3 6-5 10-6" /></>}
  {name === "lawn" && <><path d="M5 18h14" /><path d="M8 18V8l8 4-8 4" /><path d="M4 20h16" /></>}
  {name === "drop" && <path d="M12 2C8 7 6 10 6 14a6 6 0 0 0 12 0c0-4-2-7-6-12Z" />}
  {name === "spray" && <><path d="M5 11h7l2 3H5z" /><path d="M12 11V7h4v4" /><path d="M18 7h3" /><path d="M19 11h2" /><path d="M18 15h3" /></>}
  {name === "tree" && <><path d="M12 22v-7" /><path d="M8 17h8" /><path d="M6 14a6 6 0 1 1 12 0c0 2-1.5 3-3 3H9c-1.5 0-3-1-3-3Z" /></>}
  {name === "fence" && <><path d="M4 21V8l2-2 2 2v13" /><path d="M10 21V8l2-2 2 2v13" /><path d="M16 21V8l2-2 2 2v13" /><path d="M3 13h18" /><path d="M3 17h18" /></>}
  {name === "hammer" && <><path d="m14 5 5 5" /><path d="M11 8 4 15l5 5 7-7" /><path d="m13 3 8 8" /></>}
  {name === "truck" && <><path d="M3 7h11v9H3z" /><path d="M14 11h4l3 3v2h-7z" /><path d="M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /><path d="M17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /></>}
  {name === "scissors" && <><path d="m4 4 16 16" /><path d="m20 4-8.5 8.5" /><path d="M6 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /><path d="M6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /></>}
  {name === "tow" && <><path d="M4 17h12V7H4z" /><path d="M16 11h3l2 3v3h-5" /><path d="M7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /><path d="M17 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /><path d="M8 7V4h5" /></>}
  {name === "storefront" && <><path d="M4 10h16l-1.5-6h-13z" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></>}
  {name === "browser" && <><path d="M3 5h18v14H3z" /><path d="M3 9h18" /><path d="M7 13h6" /><path d="M7 16h10" /></>}
  {name === "cloud" && <><path d="M17 18H7a4 4 0 1 1 .8-7.9A6 6 0 0 1 19 12a3 3 0 0 1-2 6Z" /></>}
  {name === "map-pin" && <><path d="M12 21s7-5.2 7-12A7 7 0 1 0 5 9c0 6.8 7 12 7 12Z" /><circle cx="12" cy="9" r="2" /></>}
  {name === "star" && <path d="m12 2 2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1L6.1 20l1.2-6.5-4.8-4.6 6.6-.9L12 2Z" />}
  {name === "megaphone" && <><path d="M4 13h3l10 5V6L7 11H4z" /><path d="m7 13 1 6" /><path d="M20 9v6" /></>}
  {name === "phone" && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.7 19.7 0 0 1-8.6-3.1A19.4 19.4 0 0 1 5.2 12 19.7 19.7 0 0 1 2.1 3.4 2 2 0 0 1 4.1 1.2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 9.2a16 16 0 0 0 6.7 6.7l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />}
  {name === "dollar" && <><path d="M12 2v20" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6" /></>}
  {name === "shield" && <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />}
  {name === "chart" && <><path d="M4 20V4" /><path d="M4 20h16" /><path d="m7 16 4-4 3 3 5-7" /></>}
  {name === "calendar" && <><path d="M4 5h16v16H4z" /><path d="M8 3v4" /><path d="M16 3v4" /><path d="M4 10h16" /></>}
  {name === "mail" && <><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></>}
  {name === "clipboard" && <><path d="M8 5h8" /><path d="M9 3h6l1 2v2H8V5z" /><path d="M6 5H5v16h14V5h-1" /><path d="m8 13 2 2 5-5" /></>}
  {name === "rocket" && <><path d="M12 15 9 12c1-5 4-8 10-9-1 6-4 9-9 10Z" /><path d="M9 12 5 13l-2 5 5-2 1-4Z" /><path d="m12 15-1 4-5 2 2-5 4-1Z" /><circle cx="15" cy="7" r="1.5" /></>}
  {name === "search" && <><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></>}
  {name === "user" && <><path d="M20 21a8 8 0 0 0-16 0" /><circle cx="12" cy="8" r="4" /></>}
  {name !== "wrench" && name !== "hvac" && name !== "bolt" && name !== "roof" && name !== "leaf" && name !== "lawn" && name !== "drop" && name !== "spray" && name !== "tree" && name !== "fence" && name !== "hammer" && name !== "truck" && name !== "scissors" && name !== "tow" && name !== "storefront" && name !== "browser" && name !== "cloud" && name !== "map-pin" && name !== "star" && name !== "megaphone" && name !== "phone" && name !== "dollar" && name !== "shield" && name !== "chart" && name !== "calendar" && name !== "mail" && name !== "clipboard" && name !== "rocket" && name !== "search" && name !== "user" && <circle cx="12" cy="12" r="8" />}
</svg>
