---
import BaseHead from "../components/layout/BaseHead.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PageBackdrop from '../components/PageBackdrop.astro';
import { pageSceneForPath } from '../data/pageScenes';
import "../styles/global.css";
import '@fontsource-variable/manrope';
import '@fontsource-variable/inter';

type Schema = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: "website" | "article";
  robots?: string;
  schema?: Schema | Schema[];
  immersive?: boolean;
}

const { title, description, canonical, image, imageAlt, imageWidth, imageHeight, ogType, robots, schema, immersive = false } = Astro.props;
const pageScene = immersive ? undefined : pageSceneForPath(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      ogType={ogType}
      robots={robots}
      schema={schema}
    />
  </head>
  <body class:list={{ 'has-launch-story': immersive, 'has-page-scene': !!pageScene }}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      {pageScene ? <><PageBackdrop scene={pageScene}/><div class="page-content"><slot /></div></> : <slot />}
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
